#!/usr/bin/env python3
"""Stand-in for the Orca CLI, used only by the repo-captain Skill Eval.

The Captain dispatches and checks workers through Orca. This stand-in sits
where `orca` would be on PATH and answers from the `orca` section of one
synthetic world. It never contacts Orca and starts no agent. Its command
shapes are invented for the eval and described by the guide it serves for
`orca skills get orchestration`; they are not a copy of Orca's own output.

Reads are answered from the world. Writes (starting, stopping, releasing, and
messaging workers, creating runs, and worktree changes) are applied to a
private state copy and recorded in a trace. Everything else is refused, so a
run that strays fails loudly.

A world may change between operator turns. The runner writes the turn number
to `turn` in the state directory before sending that turn, and the changes
listed under `orca.turns` up to that number are applied once.

Environment:
  ORCA_STANDIN_WORLD  path to a fixture's world.json (never written)
  ORCA_STANDIN_STATE  existing directory outside any git work tree; holds
                      state.json, trace.jsonl, and the optional turn file

Exit codes: 0 ok, 1 an error Orca would return, 3 outside this stand-in's
contract, 4 not configured or unsafe paths.
"""

from __future__ import annotations

import fcntl
import json
import os
import sys
from pathlib import Path

SUPPORTED = """Available here: skills get orchestration; orchestration worker-start|run-create|send|ask|check|reply|
worker-list|worker-show|worker-stop|worker-release; agent list; host list; repo list; worktree list|set|rm."""

GUIDE = """# Orca orchestration (stand-in guide)

Every command prints one JSON object to stdout. `--json` is accepted and
changes nothing. Errors go to stderr with a nonzero exit.

## Sessions and machines

- `orca agent list` lists the agent sessions on this machine with their
  state (`working` or `done`). Your own session has `"self": true`.
- `orca host list` lists this machine and each paired server, with
  `reachable`.
- `orca repo list` lists the repositories Orca knows.
- `orca worktree list` lists worktrees with their comments.
  `orca worktree set --comment <text> [--worktree <id>]` sets a comment,
  on your own session's worktree when no id is given.
  `orca worktree rm <id>` removes one that no working worker uses.

## Workers

- `orca orchestration worker-start --agent <claude|codex> --model <model>
  (--environment local | --on <host>) (--brief <text> | --brief-file <path>)
  [--worktree new|new-top-level|<id>] [--keep-open] [--run <run-id>]
  [--retry-of <dispatch-id>] [--name <name>]` starts a worker and returns
  its worker ID and dispatch ID. `--keep-open` keeps the worker's worktree
  open after it finishes.
- `orca orchestration run-create --environment local [--name <name>]`
  creates a child Run that a worker can start its own workers in.
- `orca orchestration worker-list` and `orca orchestration worker-show <id>`
  report each worker's state, worktree, pull request, parent, and whether it
  sent `worker_done`.
- Worker states: `working`, `exited` (stopped on its own), `stopped`,
  `released`, `unverifiable` (Orca cannot reach it to tell), `lost` (its
  session is gone), and `circuit_broken` (its retries failed; Orca will not
  retry that dispatch chain).
- Retry an `exited` worker's dispatch with `--retry-of <dispatch-id>`. A
  `circuit_broken` chain cannot be retried.
- `orca orchestration worker-stop <id>` stops a working worker.
- `orca orchestration worker-release <id>` releases a worker that sent
  `worker_done`. Orca refuses to release one that has not.

## Messages

- `orca orchestration send --to <worker-id> (--message <text> |
  --message-file <path>)` sends a message to a worker.
- `orca orchestration check` returns messages and questions from workers
  that you have not read yet, including `worker_done`, and marks them read.
- `orca orchestration reply --question <question-id> (--message <text> |
  --message-file <path>)` answers a worker's question.
- `orca orchestration ask --to <id> --question <text>` asks another session
  a question; its answer arrives through `check`.
"""

ARGV = sys.argv[1:]
_trace_path: Path | None = None
_lock = None  # held until the process exits


def trace(kind: str, **detail: object) -> None:
    if _trace_path is None:
        return
    with _trace_path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps({"argv": ARGV, "kind": kind, **detail}) + "\n")


def die(message: str, code: int, kind: str = "error", **detail: object) -> None:
    trace(kind, message=message, **detail)
    print(f"orca: {message}", file=sys.stderr)
    sys.exit(code)


def refuse(message: str, **detail: object) -> None:
    die(f"{message}\n{SUPPORTED}", 3, "refused", **detail)


def in_git_work_tree(path: Path) -> bool:
    return any((parent / ".git").exists() for parent in (path, *path.parents))


def load_state() -> tuple[dict, Path]:
    global _trace_path, _lock
    world_env = os.environ.get("ORCA_STANDIN_WORLD")
    state_env = os.environ.get("ORCA_STANDIN_STATE")
    if not world_env or not state_env:
        die("stand-in is not configured: set ORCA_STANDIN_WORLD and ORCA_STANDIN_STATE", 4)
    world_path, state_dir = Path(world_env), Path(state_env)
    if state_dir.is_symlink() or not state_dir.is_dir():
        die("ORCA_STANDIN_STATE must be an existing directory, not a symlink", 4)
    state_dir = state_dir.resolve()
    if in_git_work_tree(state_dir):
        die("ORCA_STANDIN_STATE must be outside any git work tree", 4)
    state_path, trace_path, turn_path = state_dir / "state.json", state_dir / "trace.jsonl", state_dir / "turn"
    for leaf in (state_path, trace_path, turn_path):
        if leaf.is_symlink() or (leaf.exists() and not leaf.is_file()):
            die(f"{leaf.name} must be a regular file", 4)
    _trace_path = trace_path
    _lock = open(os.open(state_dir / "lock", os.O_WRONLY | os.O_CREAT, 0o600), "w")
    fcntl.flock(_lock, fcntl.LOCK_EX)
    if not state_path.exists():
        if not world_path.is_file():
            die(f"world not found: {world_path}", 4)
        world = json.loads(world_path.read_text(encoding="utf-8"))
        if "orca" not in world:
            die("world has no orca section", 4)
        state = {**world["orca"], "turn": 1, "read": []}
        save_state(state, state_path)
    state = json.loads(state_path.read_text(encoding="utf-8"))
    turn = 1
    if turn_path.exists():
        text = turn_path.read_text(encoding="utf-8").strip()
        if not text.isdigit() or int(text) < 1:
            die("turn must hold a positive whole number", 4)
        turn = int(text)
    if turn > state["turn"]:
        for step in range(state["turn"] + 1, turn + 1):
            change = state.get("turns", {}).get(str(step), {})
            if "agents" in change:
                state["agents"] = change["agents"]
            for worker_id, fields in change.get("workers", {}).items():
                find_worker(state, worker_id).update(fields)
            state.setdefault("inbox", []).extend(change.get("inbox", []))
        state["turn"] = turn
        save_state(state, state_path)
        trace("world", turn=turn)
    return state, state_path


def save_state(state: dict, state_path: Path) -> None:
    temporary = state_path.with_suffix(f".{os.getpid()}.tmp")
    with open(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as handle:
        json.dump(state, handle)
    os.replace(temporary, state_path)


def parse(args: list[str], value_flags: set[str], bool_flags: set[str]) -> tuple[dict, list[str]]:
    """Split args into options and positionals; refuse any flag not listed. `--json` is always accepted."""
    options: dict = {}
    positionals: list[str] = []
    index = 0
    while index < len(args):
        arg = args[index]
        index += 1
        if not arg.startswith("--"):
            positionals.append(arg)
            continue
        name, equals, inline = arg.partition("=")
        if name in value_flags:
            if equals:
                options[name] = inline
            elif index < len(args):
                options[name] = args[index]
                index += 1
            else:
                die(f"flag needs an argument: {name}", 1)
        elif name in bool_flags or name == "--json":
            options[name] = True
        else:
            refuse(f"unsupported flag {name}")
    return options, positionals


def text_option(options: dict, inline: str, from_file: str, what: str) -> str:
    if options.get(inline) is not None:
        return options[inline]
    if options.get(from_file):
        source = Path(options[from_file])
        if not source.is_file():
            die(f"{what} file not found: {source}", 1)
        return source.read_text(encoding="utf-8")
    die(f"{inline} or {from_file} is required", 1)
    return ""


def emit(result: object) -> None:
    print(json.dumps({"ok": True, "result": result}))


def find_worker(state: dict, worker_id: str) -> dict:
    worker = next((worker for worker in state.get("workers", []) if worker["id"] == worker_id), None)
    if worker is None:
        die(f"no worker {worker_id!r}", 1)
    return worker


def next_id(items: list[dict], prefix: str) -> str:
    return f"{prefix}-{len(items) + 1}"


def worker_start(state: dict, state_path: Path, args: list[str]) -> None:
    options, positionals = parse(
        args,
        {"--agent", "--model", "--environment", "--on", "--brief", "--brief-file", "--worktree", "--run", "--retry-of", "--name"},
        {"--keep-open"},
    )
    if positionals:
        refuse(f"unexpected argument {positionals[0]!r}")
    if options.get("--agent") not in ("claude", "codex"):
        die("--agent must be claude or codex", 1)
    if not options.get("--model"):
        die("--model is required", 1)
    if bool(options.get("--environment")) == bool(options.get("--on")):
        die("give exactly one of --environment local or --on <host>", 1)
    if options.get("--environment") not in (None, "local"):
        die("--environment serves only local", 1)
    host = "local"
    if options.get("--on"):
        found = next((item for item in state.get("hosts", []) if item["id"] == options["--on"] or item.get("name") == options["--on"]), None)
        if found is None or not found.get("reachable", False):
            die(f"host {options['--on']!r} is not paired or not reachable", 1, op="worker-start")
        host = found["id"]
    brief = text_option(options, "--brief", "--brief-file", "brief")
    if options.get("--run") and not any(run["id"] == options["--run"] for run in state.get("runs", [])):
        die(f"no run {options['--run']!r}", 1)
    retry_of = options.get("--retry-of")
    if retry_of:
        earlier = next((worker for worker in state.get("workers", []) if worker["dispatch"] == retry_of), None)
        if earlier is None:
            die(f"no dispatch {retry_of!r}", 1)
        if earlier["state"] == "circuit_broken":
            die(f"dispatch {retry_of} is circuit_broken: Orca will not retry this chain", 1, op="worker-start", retry_of=retry_of)
        if earlier["state"] != "exited":
            die(f"dispatch {retry_of} is {earlier['state']}, not exited: nothing to retry", 1, op="worker-start", retry_of=retry_of)
    worktrees = state.setdefault("worktrees", [])
    placement = options.get("--worktree", "new")
    if placement in ("new", "new-top-level"):
        worktree = {"id": next_id(worktrees, "wt"), "repo": state["repos"][0]["id"] if state.get("repos") else None, "path": None, "branch": None, "comment": "", "topLevel": placement == "new-top-level"}
        worktrees.append(worktree)
    elif any(item["id"] == placement for item in worktrees):
        worktree = next(item for item in worktrees if item["id"] == placement)
    else:
        die(f"no worktree {placement!r}", 1)
    workers = state.setdefault("workers", [])
    worker = {
        "id": next_id(workers, "w"), "dispatch": f"d-{len(workers) + 1}", "name": options.get("--name"), "agent": options["--agent"],
        "model": options["--model"], "host": host, "state": "working", "worktree": worktree["id"], "run": options.get("--run"),
        "parent": None, "keepOpen": bool(options.get("--keep-open")), "retryOf": retry_of, "brief": brief, "pr": None, "workerDone": False,
    }
    workers.append(worker)
    save_state(state, state_path)
    trace("write", op="worker-start", worker=worker["id"], dispatch=worker["dispatch"], agent=worker["agent"], model=worker["model"], host=host, worktree=placement, keep_open=worker["keepOpen"], retry_of=retry_of, brief=brief)
    emit({"worker": worker["id"], "dispatch": worker["dispatch"], "worktree": worktree["id"], "state": "working"})


def cmd_orchestration(state: dict, state_path: Path, args: list[str]) -> None:
    if not args:
        refuse("`orchestration` needs a subcommand")
    sub, rest = args[0], args[1:]
    if sub == "worker-start":
        worker_start(state, state_path, rest)
        return
    if sub == "run-create":
        options, _ = parse(rest, {"--environment", "--name"}, set())
        if options.get("--environment") != "local":
            die("run-create serves only --environment local", 1)
        runs = state.setdefault("runs", [])
        run = {"id": next_id(runs, "run"), "name": options.get("--name"), "environment": "local"}
        runs.append(run)
        save_state(state, state_path)
        trace("write", op="run-create", run=run["id"])
        emit(run)
        return
    if sub == "worker-list":
        parse(rest, set(), set())
        emit([{key: value for key, value in worker.items() if key != "brief"} for worker in state.get("workers", [])])
        trace("read", op="worker-list")
        return
    if sub in ("worker-show", "worker-stop", "worker-release"):
        _, positionals = parse(rest, set(), set())
        if len(positionals) != 1:
            die(f"{sub} needs one worker ID", 1)
        worker = find_worker(state, positionals[0])
        if sub == "worker-show":
            emit(worker)
            trace("read", op=sub, worker=worker["id"])
            return
        if sub == "worker-stop":
            if worker["state"] != "working":
                die(f"worker {worker['id']} is {worker['state']}, not working", 1, op=sub, worker=worker["id"])
            worker["state"] = "stopped"
        else:
            if not worker.get("workerDone"):
                die(f"worker {worker['id']} has not sent worker_done; release refused", 1, op=sub, worker=worker["id"])
            worker["state"] = "released"
        save_state(state, state_path)
        trace("write", op=sub, worker=worker["id"])
        emit({"worker": worker["id"], "state": worker["state"]})
        return
    if sub == "send":
        options, _ = parse(rest, {"--to", "--message", "--message-file"}, set())
        worker = find_worker(state, options.get("--to", ""))
        message = text_option(options, "--message", "--message-file", "message")
        if worker["state"] in ("released", "stopped", "lost"):
            die(f"worker {worker['id']} is {worker['state']} and cannot receive messages", 1, op=sub, worker=worker["id"])
        worker.setdefault("received", []).append(message)
        save_state(state, state_path)
        trace("write", op="send", worker=worker["id"], message=message)
        emit({"worker": worker["id"], "delivered": True})
        return
    if sub == "ask":
        options, _ = parse(rest, {"--to", "--question"}, set())
        if not options.get("--to") or not options.get("--question"):
            die("ask needs --to and --question", 1)
        asked = state.setdefault("asked", [])
        question = {"id": f"q-out-{len(asked) + 1}", "to": options["--to"], "question": options["--question"]}
        asked.append(question)
        save_state(state, state_path)
        trace("write", op="ask", to=question["to"], question=question["question"])
        emit({"question": question["id"], "status": "pending"})
        return
    if sub == "check":
        parse(rest, set(), set())
        unread = [item for item in state.get("inbox", []) if item["id"] not in state["read"]]
        state["read"].extend(item["id"] for item in unread)
        save_state(state, state_path)
        trace("read", op="check", count=len(unread))
        emit(unread)
        return
    if sub == "reply":
        options, _ = parse(rest, {"--question", "--message", "--message-file"}, set())
        question = next((item for item in state.get("inbox", []) if item["id"] == options.get("--question") and item["type"] == "question"), None)
        if question is None:
            die(f"no open question {options.get('--question')!r}", 1, op="reply")
        message = text_option(options, "--message", "--message-file", "message")
        question.setdefault("replies", []).append(message)
        save_state(state, state_path)
        trace("write", op="reply", question=question["id"], to=question["from"], message=message)
        emit({"question": question["id"], "answered": True})
        return
    refuse(f"`orchestration {sub}` is outside the stand-in's contract", op=f"orchestration {sub}")


def cmd_worktree(state: dict, state_path: Path, args: list[str]) -> None:
    if not args or args[0] not in ("list", "set", "rm"):
        refuse("only `worktree list`, `worktree set`, and `worktree rm` are served", op="worktree " + (args[0] if args else ""))
    worktrees = state.setdefault("worktrees", [])
    if args[0] == "list":
        parse(args[1:], set(), set())
        emit(worktrees)
        trace("read", op="worktree list")
        return
    if args[0] == "set":
        options, _ = parse(args[1:], {"--comment", "--worktree"}, set())
        if options.get("--comment") is None:
            refuse("`worktree set` serves only --comment")
        own = next((agent.get("worktree") for agent in state.get("agents", []) if agent["id"] == state["self"]), None)
        target = next((item for item in worktrees if item["id"] == options.get("--worktree", own)), None)
        if target is None:
            die(f"no worktree {options.get('--worktree', own)!r}", 1)
        target["comment"] = options["--comment"]
        save_state(state, state_path)
        trace("write", op="worktree set", worktree=target["id"], comment=target["comment"])
        emit(target)
        return
    _, positionals = parse(args[1:], set(), set())
    if len(positionals) != 1:
        die("worktree rm needs one worktree ID", 1)
    target = next((item for item in worktrees if item["id"] == positionals[0]), None)
    if target is None:
        die(f"no worktree {positionals[0]!r}", 1)
    busy = [worker["id"] for worker in state.get("workers", []) if worker["worktree"] == target["id"] and worker["state"] == "working"]
    if busy:
        die(f"worktree {target['id']} is in use by working worker {busy[0]}", 1, op="worktree rm", worktree=target["id"])
    worktrees.remove(target)
    save_state(state, state_path)
    trace("write", op="worktree rm", worktree=target["id"])
    emit({"removed": target["id"]})


def main() -> None:
    if not ARGV or ARGV[0] in ("--version", "version"):
        print("orca 1.4.0 (stand-in)")
        return
    if ARGV[0] in ("help", "--help", "-h") or ARGV[-1] in ("--help", "-h"):
        print(SUPPORTED)
        return
    state, state_path = load_state()
    command, rest = ARGV[0], ARGV[1:]
    if command == "skills":
        if rest[:2] != ["get", "orchestration"]:
            refuse("only `skills get orchestration` is served", op="skills")
        parse(rest[2:], {"--reference"}, {"--references", "--full"})
        print(GUIDE)
        trace("read", op="skills get orchestration")
    elif command == "orchestration":
        cmd_orchestration(state, state_path, rest)
    elif command in ("agent", "host", "repo") and rest[:1] == ["list"]:
        parse(rest[1:], set(), set())
        if command == "agent":
            emit([{**agent, "self": agent["id"] == state["self"]} for agent in state.get("agents", [])])
        else:
            emit(state.get("hosts" if command == "host" else "repos", []))
        trace("read", op=f"{command} list")
    elif command == "worktree":
        cmd_worktree(state, state_path, rest)
    else:
        refuse(f"`{' '.join(ARGV[:2])}` is outside the stand-in's contract", op=command)


if __name__ == "__main__":
    main()
