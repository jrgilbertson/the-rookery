def find_issue(state: dict, options: dict, positionals: list[str]) -> tuple[str, str, dict]:
    if not positionals:
        die("issue number required", 1)
    slug, number = locate(positionals[0], "issues", options)
    issue = require_repo(state, slug).get("issues", {}).get(number)
    if issue is None:
        not_found(f"issue {slug}#{number}")
    return slug, number, issue


