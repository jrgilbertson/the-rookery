SUPPORTED = """Available here: api (GET user, user/orgs, repos/..., search/issues; graphql for viewer, mergeQueue,
mergeQueueEntry, reviewThreads, issueFields, issueFieldValues, and the setIssueFieldValue mutation),
search prs, pr view|list|diff|checks|comment|edit|merge|review|create, issue view|list|edit|close,
repo view|list, label list|create, auth status."""
ARGV = sys.argv[1:]
_trace_path: Path | None = None
_lock = None  # held until the process exits


def trace(kind: str, **detail: object) -> None:
    if _trace_path is None:
        return
    with _trace_path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps({"argv": ARGV, "kind": kind, **detail}) + "\n")


def die(message: str, code: int, kind: str = "error", **detail: object) -> None:
    trace(kind, message=message, **detail)
    print(f"gh: {message}", file=sys.stderr)
    sys.exit(code)


def refuse(message: str, **detail: object) -> None:
    die(f"{message}\n{SUPPORTED}", 3, "refused", **detail)


def not_found(what: str) -> None:
    die(f"HTTP 404: Not Found ({what})", 1)


# ---------------------------------------------------------------- state


def in_git_work_tree(path: Path) -> bool:
    return any((parent / ".git").exists() for parent in (path, *path.parents))


def load_state() -> tuple[dict, Path]:
    global _trace_path, _lock
    world_env = os.environ.get("GH_STANDIN_WORLD")
    state_env = os.environ.get("GH_STANDIN_STATE")
    if not world_env or not state_env:
        die("stand-in is not configured: set GH_STANDIN_WORLD and GH_STANDIN_STATE", 4)
    world_path = Path(world_env)
    state_dir = Path(state_env)
    if state_dir.is_symlink() or not state_dir.is_dir():
        die("GH_STANDIN_STATE must be an existing directory, not a symlink", 4)
    state_dir = state_dir.resolve()
    if in_git_work_tree(state_dir):
        die("GH_STANDIN_STATE must be outside any git work tree", 4)
    state_path = state_dir / "state.json"
    trace_path = state_dir / "trace.jsonl"
    for leaf in (state_path, trace_path):
        if leaf.is_symlink() or (leaf.exists() and not leaf.is_file()):
            die(f"{leaf.name} must be a regular file", 4)
    _trace_path = trace_path
    # Agents issue calls in parallel. Hold one lock from the first read to exit.
    _lock = open(os.open(state_dir / "lock", os.O_WRONLY | os.O_CREAT, 0o600), "w")
    fcntl.flock(_lock, fcntl.LOCK_EX)
    if not state_path.exists():
        if not world_path.is_file():
            die(f"world not found: {world_path}", 4)
        world = json.loads(world_path.read_text(encoding="utf-8"))
        world["clock"] = 0
        world["turn"] = 1
        save_state(world, state_path)
    state = json.loads(state_path.read_text(encoding="utf-8"))
    turn = current_turn(state_dir / "turn")
    if turn > state["turn"]:
        advance(state, turn)
        save_state(state, state_path)
        trace("world", turn=turn)
    return state, state_path


def current_turn(leaf: Path) -> int:
    if leaf.is_symlink() or (leaf.exists() and not leaf.is_file()):
        die("turn must be a regular file", 4)
    if not leaf.exists():
        return 1
    text = leaf.read_text(encoding="utf-8").strip()
    if not text.isdigit() or int(text) < 1:
        die("turn must hold a positive whole number", 4)
    return int(text)


def advance(state: dict, turn: int) -> None:
    for step in range(state["turn"] + 1, turn + 1):
        for slug, repo in state["repos"].items():
            for number, pull in repo.get("pulls", {}).items():
                if pull.pop("mergeQueueEntry", None) is None:
                    continue
                outcomes = pull.get("queueOutcomes", [])
                if (outcomes.pop(0) if outcomes else "MERGED") == "MERGED":
                    merge_pull(state, slug, number, pull)
        for change in state.get("turns", {}).get(str(step), []):
            slug, _, number = change["pull"].partition("#")
            pull = state["repos"][slug]["pulls"][number]
            pull.update(change.get("set", {}))
            pull.setdefault("comments", []).extend(change.get("comments", []))
    state["turn"] = turn


def merge_pull(state: dict, slug: str, number: str, pull: dict) -> None:
    pull.update(state="MERGED", mergedAt=tick(state), mergedBy=state["viewer"]["login"], mergeCommit=hashlib.sha1(f"{slug}#{number}".encode()).hexdigest())
    for other in pull.get("conflictsWith", []):
        blocked = state["repos"][slug]["pulls"].get(str(other))
        if blocked and blocked["state"] == "OPEN":
            blocked.update(mergeable="CONFLICTING", mergeStateStatus="DIRTY")


def save_state(state: dict, state_path: Path) -> None:
    temporary = state_path.with_suffix(f".{os.getpid()}.tmp")
    with open(os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as handle:
        json.dump(state, handle)
    os.replace(temporary, state_path)


def tick(state: dict) -> str:
    state["clock"] += 1
    base = datetime.strptime(state["now"], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    return (base + timedelta(minutes=state["clock"])).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------- arguments


def parse(args: list[str], value_flags: dict[str, str], bool_flags: dict[str, str]) -> tuple[dict, list[str]]:
    """Split args into options and positionals; refuse any flag not listed."""
    options: dict = {}
    positionals: list[str] = []
    index = 0
    while index < len(args):
        arg = args[index]
        index += 1
        if arg == "--":
            positionals.extend(args[index:])
            break
        if not arg.startswith("-") or arg == "-":
            positionals.append(arg)
            continue
        name, _, inline = arg.partition("=")
        if name in value_flags:
            if "=" in arg:
                value = inline
            elif index < len(args):
                value = args[index]
                index += 1
            else:
                die(f"flag needs an argument: {name}", 1)
            options.setdefault(value_flags[name], []).append(normal_slug(value) if value_flags[name] == "repo" else value)
        elif name in bool_flags:
            options[bool_flags[name]] = inline.lower() != "false"
        else:
            refuse(f"unsupported flag {name}")
    return options, positionals


def normal_slug(value: str) -> str:
    """Accept OWNER/REPO with or without the github.com host, as gh does."""
    for prefix in ("https://github.com/", "github.com/"):
        if value.lower().startswith(prefix):
            return value[len(prefix):]
    return value


REPO_FLAGS = {"-R": "repo", "--repo": "repo"}
JSON_FLAGS = {**REPO_FLAGS, "--json": "json", "--jq": "jq", "-q": "jq", "-L": "limit", "--limit": "limit"}
BODY_FLAGS = {"--body": "body", "-b": "body", "--body-file": "body-file", "-F": "body-file"}


def one(options: dict, key: str, default: str | None = None) -> str | None:
    values = options.get(key)
    return values[-1] if values else default


def many(options: dict, key: str) -> list[str]:
    return [part for value in options.get(key, []) for part in value.split(",") if part]


def emit(data: object, options: dict, fields: list[str] | None = None, text: str | None = None) -> None:
    """Print data the way gh does for --json/--jq, or plain text without them."""
    requested = many(options, "json")
    jq = one(options, "jq")
    if not requested and fields is not None and jq is None:
        print(text if text is not None else json.dumps(data, indent=2))
        return
    if requested and fields is not None:
        unknown = [name for name in requested if name not in fields]
        if unknown:
            die(f"Unknown JSON field: {unknown[0]!r}\nAvailable fields:\n  " + "\n  ".join(sorted(fields)), 1)
        def pick(item: dict) -> dict:
            return {name: item.get(name) for name in requested}

        data = [pick(item) for item in data] if isinstance(data, list) else pick(data)
    if isinstance(data, str) and jq is None:
        sys.stdout.write(data)
        return
    if jq is None:
        print(json.dumps(data))
        return
    jq_binary = shutil.which("jq")
    if not jq_binary:
        die("stand-in is not configured: --jq needs the jq program on PATH", 4)
    result = subprocess.run([jq_binary, "-r", jq], input=json.dumps(data), capture_output=True, text=True, check=False)
    if result.returncode != 0:
        die(f"jq error: {result.stderr.strip()}", 1)
    sys.stdout.write(result.stdout)


# ---------------------------------------------------------------- objects


def diff_files(diff: str) -> list[dict]:
    files: list[dict] = []
    for line in diff.splitlines():
        if line.startswith("diff --git "):
            path = line.split(" b/", 1)[1] if " b/" in line else line.split()[-1]
            files.append({"path": path, "additions": 0, "deletions": 0, "patch": []})
        elif files:
            files[-1]["patch"].append(line)
            if line.startswith("+") and not line.startswith("+++"):
                files[-1]["additions"] += 1
            elif line.startswith("-") and not line.startswith("---"):
                files[-1]["deletions"] += 1
    return files


def label_objects(repo: dict, names: list[str]) -> list[dict]:
    known = {label["name"]: label for label in repo.get("labels", [])}
    return [known.get(name, {"name": name, "color": "ededed", "description": ""}) for name in names]


def comment_objects(slug: str, number: str, comments: list[dict]) -> list[dict]:
    return [
        {
            "id": f"IC_{number}_{position}",
            "author": {"login": comment["author"]},
            "body": comment["body"],
            "createdAt": comment["createdAt"],
            "url": f"https://github.com/{slug}/pull/{number}#issuecomment-{number}{position:03d}",
        }
        for position, comment in enumerate(comments, start=1)
    ]


