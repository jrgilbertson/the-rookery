def require_repo(state: dict, slug: str | None, missing: str = "no git remotes found; pass -R OWNER/REPO") -> dict:
    if not slug:
        die(missing, 1)
    if slug not in state["repos"]:
        not_found(f"repository {slug}")
    return state["repos"][slug]


def locate(target: str, kind: str, options: dict) -> tuple[str | None, str]:
    """Read OWNER/REPO and a number from a github.com URL, or a number and -R."""
    match = re.match(rf"https://github\.com/([^/]+/[^/]+)/{kind}/(\d+)", target)
    return (match.group(1), match.group(2)) if match else (one(options, "repo"), target.lstrip("#"))


def find_pull(state: dict, options: dict, positionals: list[str]) -> tuple[str, str, dict]:
    if not positionals:
        die("no pull request found: give a number and -R OWNER/REPO, or a URL", 1)
    slug, number = locate(positionals[0], "pull", options)
    pull = require_repo(state, slug).get("pulls", {}).get(number)
    if pull is None:
        not_found(f"pull request {slug}#{number}")
    return slug, number, pull


# ---------------------------------------------------------------- search


def moment(text: str, end_of_day: bool = False) -> datetime:
    """A GitHub search date or date-time, compared the way GitHub compares it."""
    text = text.strip().strip('"')
    if len(text) == 10:
        return datetime.fromisoformat(text + ("T23:59:59+00:00" if end_of_day else "T00:00:00+00:00"))
    stamp = datetime.fromisoformat(text.replace("Z", "+00:00"))
    return stamp if stamp.tzinfo else stamp.replace(tzinfo=timezone.utc)


def date_matches(value: str | None, expression: str) -> bool:
    """Compare full timestamps; a bare date covers its whole day, as on GitHub."""
    if not value:
        return False
    at = moment(value)
    try:
        if ".." in expression:
            low, high = expression.split("..", 1)
            return (low in ("", "*") or at >= moment(low)) and (high in ("", "*") or at <= moment(high, end_of_day=True))
        for operator in (">=", "<=", ">", "<"):
            if expression.startswith(operator):
                bound = expression[len(operator):]
                return {
                    ">=": at >= moment(bound),
                    "<=": at <= moment(bound, end_of_day=True),
                    ">": at > moment(bound, end_of_day=True),
                    "<": at < moment(bound),
                }[operator]
        return moment(expression) <= at <= moment(expression, end_of_day=True)
    except ValueError:
        refuse(f"unsupported date {expression!r}")
        return False


def search(state: dict, filters: dict, terms: list[str]) -> list[tuple[str, str]]:
    """Filter every pull request by gh search flags and the same qualifiers typed inline."""
    filters = {key: list(value) if isinstance(value, list) else value for key, value in filters.items()}
    text_terms: list[str] = []
    try:
        tokens = shlex.split(" ".join(terms))
    except ValueError:
        refuse("unbalanced quotes in the search query")
    for term in tokens:
        key, colon, value = term.partition(":")
        if not colon or " " in key or not re.fullmatch(r"[a-z-]+", key) or not value or value.startswith(" "):
            text_terms.append(term.lower())
        elif key in ("org", "user", "owner"):
            filters.setdefault("owner", []).append(value)
        elif key in ("repo", "label", "author", "commenter", "review-requested"):
            filters.setdefault(key, []).append(value)
        elif key == "is" and value in ("pr", "issue", "open", "closed", "merged", "unmerged", "draft"):
            if value == "issue":
                return []
            if value in ("open", "closed"):
                filters["state"] = [value]
            elif value in ("merged", "unmerged"):
                filters["merged"] = value == "merged"
            elif value == "draft":
                filters["draft"] = True
        elif key in ("type", "state"):
            if key == "state":
                filters["state"] = [value]
        elif key in ("draft", "archived"):
            filters[key] = value == "true"
        elif key == "merged":
            filters.setdefault("merged-at", []).append(value)
        elif key == "in" and set(value.split(",")) <= {"title", "body", "comments"}:
            filters.setdefault("match", []).append(value)
        elif key == "sort":
            continue
        else:
            refuse(f"unsupported search qualifier {term!r}")
    results = []
    for slug, repo in state["repos"].items():
        if filters.get("owner") and slug.split("/")[0] not in many(filters, "owner"):
            continue
        if filters.get("repo") and slug not in many(filters, "repo"):
            continue
        if "archived" in filters and repo.get("isArchived", False) != filters["archived"]:
            continue
        if filters.get("visibility") and repo["visibility"].lower() not in many(filters, "visibility"):
            continue
        for number, pull in repo.get("pulls", {}).items():
            state_name = one(filters, "state")
            if state_name in ("open", "closed") and (pull["state"] == "OPEN") != (state_name == "open"):
                continue
            if "draft" in filters and pull.get("isDraft", False) != filters["draft"]:
                continue
            if "merged" in filters and (pull["state"] == "MERGED") != filters["merged"]:
                continue
            if any(not date_matches(pull.get("mergedAt"), expr) for expr in filters.get("merged-at", [])):
                continue
            if any(label not in pull.get("labels", []) for label in many(filters, "label")):
                continue
            if filters.get("author") and pull["author"] not in many(filters, "author"):
                continue
            commenters = {comment["author"] for comment in pull.get("comments", [])}
            if any(login not in commenters for login in many(filters, "commenter")):
                continue
            requested = pull.get("reviewRequests", [])
            if any((state["viewer"]["login"] if login == "@me" else login) not in requested for login in many(filters, "review-requested")):
                continue
            fields = many(filters, "match") or ["title", "body"]
            haystack = " ".join(
                [pull["title"]] * ("title" in fields) + [pull.get("body", "")] * ("body" in fields)
                + [comment["body"] for comment in pull.get("comments", [])] * ("comments" in fields)
            ).lower()
            if any(term not in haystack for term in text_terms):
                continue
            results.append((slug, number))
    if one(filters, "sort") in ("updated", "created"):
        key = "updatedAt" if one(filters, "sort") == "updated" else "createdAt"
        results.sort(key=lambda match: state["repos"][match[0]]["pulls"][match[1]][key], reverse=one(filters, "order", "desc") != "asc")
    return results


