        "id": f"PR_{name}_{number}",
        "number": int(number),
        "title": pull["title"],
        "body": pull.get("body", ""),
        "state": pull["state"],
        "isDraft": pull.get("isDraft", False),
        "closed": pull["state"] != "OPEN",
        "url": f"https://github.com/{slug}/pull/{number}",
        "author": {"login": pull["author"], "is_bot": pull["author"].endswith("[bot]")},
        "headRefOid": pull["headRefOid"],
        "headRefName": pull.get("headRefName", f"pr-{number}"),
        "baseRefName": pull.get("baseRefName", repo["defaultBranch"]),
        "isCrossRepository": head_owner != owner,
