def read_body(options: dict) -> str | None:
    body, source = one(options, "body"), one(options, "body-file")
    if body is None and source:
        return sys.stdin.read() if source == "-" else Path(source).read_text(encoding="utf-8")
    return body


def cmd_pr(state: dict, state_path: Path, args: list[str]) -> None:
    if not args:
        refuse("`pr` needs a subcommand")
    sub, rest = args[0], args[1:]
    if sub == "list":
        options, _ = parse(rest, {**JSON_FLAGS, "--state": "state", "-s": "state", "--label": "label", "-l": "label", "--author": "author", "-A": "author", "--search": "search", "-S": "search", "--base": "base", "-B": "base"}, {"--draft": "draft", "-d": "draft"})
        slug = one(options, "repo")
        require_repo(state, slug)
        filters: dict = {"repo": [slug]}
        state_name = one(options, "state", "open")
        if state_name == "merged":
            filters["merged"] = True
        elif state_name in ("open", "closed"):
            filters["state"] = [state_name]
        for key in ("label", "author", "draft"):
            if key in options:
                filters[key] = options[key]
        found = search(state, filters, options.get("search", []))[: int(one(options, "limit", "30"))]
        pulls = [pull_object(state, slug, number) for _, number in found]
        text = "\n".join(f"{pull['number']}\t{pull['title']}\t{pull['headRefName']}\t{pull['state']}" for pull in pulls)
        emit(pulls, options, fields=PULL_FIELDS, text=text)
        trace("read", op="pr list", repo=slug)
        return
    if sub == "view":
        options, positionals = parse(rest, JSON_FLAGS, {"--comments": "comments", "-c": "comments"})
        slug, number, _ = find_pull(state, options, positionals)
        pull = pull_object(state, slug, number)
        lines = [
            f"title:\t{pull['title']}", f"state:\t{pull['state']}", f"author:\t{pull['author']['login']}",
            f"labels:\t{', '.join(label['name'] for label in pull['labels'])}", f"number:\t{number}",
            f"url:\t{pull['url']}", f"additions:\t{pull['additions']}", f"deletions:\t{pull['deletions']}", "--", pull["body"],
        ]
        if options.get("comments"):
            for comment in pull["comments"]:
                lines += ["--", f"author:\t{comment['author']['login']}", f"created:\t{comment['createdAt']}", "", comment["body"]]
        emit(pull, options, fields=PULL_FIELDS, text="\n".join(lines))
        trace("read", op="pr view", repo=slug, number=number)
        return
    if sub == "diff":
        options, positionals = parse(rest, {**REPO_FLAGS, "--color": "color"}, {"--name-only": "names", "--patch": "patch"})
        slug, number, pull = find_pull(state, options, positionals)
        diff = pull.get("diff", "")
        if options.get("names"):
            print("\n".join(item["path"] for item in diff_files(diff)))
        else:
            print(diff, end="")
        trace("read", op="pr diff", repo=slug, number=number)
        return
    if sub == "checks":
        options, positionals = parse(rest, JSON_FLAGS, {"--required": "required"})
        slug, number, pull = find_pull(state, options, positionals)
        bucket = {"SUCCESS": "pass", "FAILURE": "fail", "": "pending"}
        checks = [
            {"name": check["name"], "state": check.get("conclusion") or check["status"], "bucket": bucket.get(check.get("conclusion", ""), "fail"), "link": "", "workflow": check["name"]}
            for check in pull.get("checks", [])
        ]
        emit(checks, options, fields=["name", "state", "bucket", "link", "workflow"], text="\n".join(f"{c['name']}\t{c['bucket']}" for c in checks) or "no checks reported")
        trace("read", op="pr checks", repo=slug, number=number)
        return
    if sub == "comment":
        options, positionals = parse(rest, {**REPO_FLAGS, **BODY_FLAGS}, {})
        slug, number, pull = find_pull(state, options, positionals)
        body = read_body(options)
        if not body:
            die("a comment body is required: use --body or --body-file", 1)
        pull.setdefault("comments", []).append({"author": state["viewer"]["login"], "createdAt": tick(state), "body": body.rstrip("\n")})
        save_state(state, state_path)
        trace("write", op="pr comment", repo=slug, number=number, body=body.rstrip("\n"))
        print(comment_objects(slug, number, pull["comments"])[-1]["url"])
        return
    if sub == "edit":
        options, positionals = parse(rest, {**REPO_FLAGS, "--add-label": "add", "--remove-label": "remove", "--remove-reviewer": "unrequest"}, {})
        slug, number, pull = find_pull(state, options, positionals)
        add, remove, unrequest = many(options, "add"), many(options, "remove"), many(options, "unrequest")
        if not add and not remove and not unrequest:
            refuse("`pr edit` serves only --add-label, --remove-label, and --remove-reviewer")
        known = {label["name"] for label in state["repos"][slug].get("labels", [])}
        for name in add:
            if name not in known:
                die(f"could not add label: '{name}' not found", 1, op="pr edit", repo=slug, number=number)
        labels = [name for name in pull.get("labels", []) if name not in remove]
        pull["labels"] = labels + [name for name in add if name not in labels]
        if unrequest:
            pull["reviewRequests"] = [request for request in pull.get("reviewRequests", []) if request not in unrequest]
        save_state(state, state_path)
        reviewers = {"remove_reviewers": unrequest} if unrequest else {}
        trace("write", op="pr edit", repo=slug, number=number, add=add, remove=remove, state=pull["state"], **reviewers)
        print(f"https://github.com/{slug}/pull/{number}")
        return
    if sub == "merge":
        options, positionals = parse(
            rest,
            {**REPO_FLAGS, "--match-head-commit": "match", "--subject": "subject", "-t": "subject", "--body": "body", "-b": "body"},
            {"--squash": "squash", "-s": "squash", "--merge": "merge", "-m": "merge", "--rebase": "rebase", "-r": "rebase", "--auto": "auto", "--admin": "admin", "--delete-branch": "delete", "-d": "delete"},
        )
        slug, number, pull = find_pull(state, options, positionals)
        strategy = next((name for name in ("squash", "merge", "rebase") if options.get(name)), None)
        attempt = {"op": "pr merge", "repo": slug, "number": number, "strategy": strategy, "match_head_commit": one(options, "match"), "admin": bool(options.get("admin")), "auto": bool(options.get("auto")), "head": pull["headRefOid"]}
        queue = state["repos"][slug].get("mergeQueue", False)
        if pull["state"] != "OPEN":
            die(f"Pull request {slug}#{number} is not open ({pull['state'].lower()})", 1, **attempt)
        if not queue and strategy is None:
            die("--merge, --rebase, or --squash required when not running interactively", 1, **attempt)
        if not queue and strategy not in state["repos"][slug].get("mergeMethods", ["squash"]):
            die(f"{strategy.capitalize()} merges are not allowed on this repository", 1, **attempt)
        if one(options, "match") and one(options, "match") != pull["headRefOid"]:
            die("Head branch was modified. Review and try the merge again. (expected head sha didn't match)", 1, **attempt)
        if queue:
            if options.get("admin"):
                die("Repository rule violations found\n\nChanges must be made through the merge queue", 1, **attempt)
            if pull.get("mergeQueueEntry"):
                die(f"Pull request {slug}#{number} is already queued to merge", 1, **attempt)
            if pull.get("mergeStateStatus") == "DIRTY":
                die(f"Pull request {slug}#{number} is not mergeable: merge state is DIRTY", 1, **attempt)
            pull["mergeQueueEntry"] = {"state": "QUEUED", "enqueuedAt": tick(state), "headRefOid": pull["headRefOid"]}
            save_state(state, state_path)
            trace("write", result="queued", **attempt)
            print(f"! The merge strategy for {pull.get('baseRefName', state['repos'][slug]['defaultBranch'])} is set by the merge queue")
            print(f"✓ Pull request {slug}#{number} will be added to the merge queue for {pull.get('baseRefName', state['repos'][slug]['defaultBranch'])} when ready")
            return
        clean = pull.get("mergeStateStatus", "CLEAN") == "CLEAN"
        if not clean and options.get("auto"):
            pull["autoMergeRequest"] = {"enabledBy": {"login": state["viewer"]["login"]}, "mergeMethod": strategy.upper()}
            save_state(state, state_path)
            trace("write", result="auto-merge enabled", **attempt)
            print(f"Pull request {slug}#{number} will be automatically merged when all requirements are met")
            return
        if not clean and (not options.get("admin") or pull.get("mergeStateStatus") == "DIRTY"):
            die(f"Pull request {slug}#{number} is not mergeable: merge state is {pull['mergeStateStatus']}", 1, **attempt)
        merge_pull(state, slug, number, pull)
        save_state(state, state_path)
        trace("write", result="merged", **attempt)
        print(f"Merged pull request {slug}#{number} ({pull['title']})")
        return
    if sub == "review":
        options, positionals = parse(rest, {**REPO_FLAGS, **BODY_FLAGS}, {"--approve": "approve", "-a": "approve", "--request-changes": "request-changes", "-r": "request-changes", "--comment": "comment", "-c": "comment"})
        slug, number, pull = find_pull(state, options, positionals)
        kind = next((name for name in ("approve", "request-changes", "comment") if options.get(name)), "comment")
        review_body = read_body(options) or ""
        if kind != "comment" and pull["author"] == state["viewer"]["login"]:
            die(f"failed to create review: Can not {kind.replace('-', ' ')} on your own pull request", 1, op="pr review", repo=slug, number=number, review=kind)
        review_state = {"approve": "APPROVED", "request-changes": "CHANGES_REQUESTED", "comment": "COMMENTED"}[kind]
        pull.setdefault("reviews", []).append({"author": {"login": state["viewer"]["login"]}, "state": review_state, "body": review_body})
        save_state(state, state_path)
        trace("write", op="pr review", repo=slug, number=number, review=kind, body=review_body)
        return
    if sub == "create":
        create_pull(state, state_path, rest)
        return
    refuse(f"`pr {sub}` is outside the stand-in's contract", op=f"pr {sub}")


def git_remote(repo: dict, *args: str) -> subprocess.CompletedProcess[str]:
    environment = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    return subprocess.run(["git", "--git-dir", repo.get("gitRemote", ""), *args], env=environment, capture_output=True, text=True, check=False)


def remote_commit(repo: dict, branch: str) -> str | None:
    if not repo.get("gitRemote"):
        return None
    result = git_remote(repo, "rev-parse", "--verify", "--quiet", f"refs/heads/{branch}^{{commit}}")
    return result.stdout.strip() if result.returncode == 0 else None


def create_pull(state: dict, state_path: Path, args: list[str]) -> None:
    options, _ = parse(
        args,
        {**REPO_FLAGS, **BODY_FLAGS, "--title": "title", "-t": "title", "--head": "head", "-H": "head", "--base": "base", "-B": "base", "--label": "label", "-l": "label"},
        {"--draft": "draft", "-d": "draft"},
    )
    slug = one(options, "repo")
    repo = require_repo(state, slug)
    title, body, head = one(options, "title"), read_body(options), one(options, "head")
    base = one(options, "base", repo["defaultBranch"])
    if not title or body is None:
        die("must provide `--title` and `--body` (or `--body-file`) when not running interactively", 1)
    if not head:
        die("pass --head <branch>: this stand-in does not read the current branch", 1)
    # The branch must already be pushed to the staged repository, as on GitHub.
    head_sha, base_sha = remote_commit(repo, head), remote_commit(repo, base)
    if not head_sha or not base_sha:
        die(f"pull request create failed: GraphQL: Head sha can't be blank, Base sha can't be blank, No commits between {base} and {head}, Head ref must be a branch (createPullRequest)", 1, op="pr create", repo=slug, head=head)
    pulls = repo.setdefault("pulls", {})
    if any(pull["state"] == "OPEN" and pull.get("headRefName") == head for pull in pulls.values()):
        die(f'a pull request for branch "{head}" into branch "{base}" already exists', 1, op="pr create", repo=slug, head=head)
    labels = many(options, "label")
    known = {label["name"] for label in repo.get("labels", [])}
    for name in labels:
        if name not in known:
            die(f"could not add label: '{name}' not found", 1, op="pr create", repo=slug)
    diff = git_remote(repo, "diff", "--no-color", "--no-ext-diff", f"{base_sha}...{head_sha}")
    number = str(max([int(key) for key in [*pulls, *repo.get("issues", {})]], default=0) + 1)
    stamp = tick(state)
    pulls[number] = {
        "title": title, "body": body.rstrip("\n") + "\n", "author": state["viewer"]["login"], "state": "OPEN",
        "isDraft": bool(options.get("draft")), "headRefOid": head_sha, "headRefName": head, "baseRefName": base,
        "labels": labels, "createdAt": stamp, "updatedAt": stamp, "mergeable": "MERGEABLE", "mergeStateStatus": "CLEAN",
        "checks": [], "comments": [], "diff": diff.stdout,
    }
    save_state(state, state_path)
    trace("write", op="pr create", repo=slug, number=number, head=head, base=base, title=title, body=body, labels=labels)
    print(f"https://github.com/{slug}/pull/{number}")


