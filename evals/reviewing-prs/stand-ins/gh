    trace("write", op="label create", repo=slug, label=label)
    print(f'Label "{name}" created in {slug}')


def cmd_api(state: dict, state_path: Path, args: list[str]) -> None:
    options, positionals = parse(
        args,
        {"-X": "method", "--method": "method", "-f": "field", "-F": "field", "--raw-field": "field", "--field": "field", "-H": "header", "--header": "header", "--jq": "jq", "-q": "jq", "--input": "input", "--hostname": "hostname"},
        {"--paginate": "paginate", "--slurp": "slurp", "--silent": "silent"},
    )
    if one(options, "hostname", "github.com") != "github.com":
        die(f"this stand-in serves only github.com, not {one(options, 'hostname')}", 1)
    if not positionals:
        die("accepts 1 arg(s), received 0", 1)
    endpoint, _, query_string = positionals[0].lstrip("/").partition("?")
    query = dict(pair.split("=", 1) for pair in query_string.split("&") if "=" in pair)
    fields = dict(field.split("=", 1) for field in options.get("field", []) if "=" in field)
    if endpoint == "graphql":
        document = fields.get("query", "")
        slug = f"{fields.get('owner', '')}/{fields.get('repo', fields.get('name', ''))}"
        if "setIssueFieldValue" in document:
            set_issue_fields(state, state_path, document, fields, options)
            return
        if "enqueuePullRequest" in document:
            if any(repo.get("mergeQueue") for repo in state["repos"].values()):
                refuse("enqueue through gh pr merge, which adds a pull request to its repository's merge queue", op="graphql enqueuePullRequest", document=document)
            die('{"errors":[{"message":"Merge queue is not enabled for this branch"}]}', 1, op="graphql enqueuePullRequest", document=document)
        if "mutation" in document:
            refuse("GraphQL mutations are outside the stand-in's contract; use gh pr comment, gh pr edit, gh pr merge, or gh label create", op="graphql mutation", document=document)
        if "mergeQueueEntry" in document:
            pull = state["repos"].get(slug, {}).get("pulls", {}).get(fields.get("number", ""))
            if pull is None:
                die('{"errors":[{"message":"Could not resolve to a PullRequest"}]}', 1, op="graphql mergeQueueEntry", slug=slug)
            entry = pull.get("mergeQueueEntry")
            emit({"data": {"repository": {"pullRequest": {"number": int(fields["number"]), "state": pull["state"], "headRefOid": pull["headRefOid"], "mergeQueueEntry": entry}}}}, options)
        elif "mergeQueue" in document:
            repo = state["repos"].get(slug, {})
            queued = [(number, pull) for number, pull in repo.get("pulls", {}).items() if pull.get("mergeQueueEntry")]
            queued.sort(key=lambda item: item[1]["mergeQueueEntry"]["enqueuedAt"])
            nodes = [{"position": position, "state": pull["mergeQueueEntry"]["state"], "headCommit": {"oid": pull["mergeQueueEntry"]["headRefOid"]}, "pullRequest": {"number": int(number)}} for position, (number, pull) in enumerate(queued, start=1)]
            emit({"data": {"repository": {"mergeQueue": {"entries": {"totalCount": len(nodes), "nodes": nodes}} if repo.get("mergeQueue") else None}}}, options)
        elif "issueFieldValues" in document:
            issue = state["repos"].get(slug, {}).get("issues", {}).get(fields.get("number", ""))
            if issue is None:
                die('{"errors":[{"message":"Could not resolve to an Issue"}]}', 1, op="graphql issueFieldValues", slug=slug)
            ids = {name: identifier for identifier, name in ISSUE_FIELDS}
            nodes = [{"__typename": "IssueFieldNumberValue", "value": float(value), "field": {"id": ids[name], "name": name}} for name, value in issue.get("fields", {}).items()]
            emit({"data": {"repository": {"issue": {"id": issue_id(slug, fields["number"]), "issueFieldValues": {"nodes": nodes, "pageInfo": {"hasNextPage": False}}}}}}, options)
        elif "issueFields" in document:
            nodes = [{"id": identifier, "name": name, "dataType": "NUMBER"} for identifier, name in ISSUE_FIELDS]
            emit({"data": {"repository": {"issueFields": {"nodes": nodes, "pageInfo": {"hasNextPage": False, "endCursor": None}}}}}, options)
        elif "reviewThreads" in document:
            slug = f"{fields.get('owner', '')}/{fields.get('repo', '')}"
            if slug not in state["repos"] or fields.get("number", "") not in state["repos"][slug]["pulls"]:
                die('{"errors":[{"message":"Could not resolve to a PullRequest"}]}', 1, op="graphql reviewThreads", slug=slug)
            threads = state["repos"][slug]["pulls"][fields["number"]].get("reviewThreads", [])
            nodes = [
                {"isResolved": thread.get("isResolved", False), "comments": {"totalCount": len(thread.get("comments", [])), "nodes": [
                    {"author": {"login": comment["author"]}, "body": comment["body"]} for comment in thread.get("comments", [])
                ]}}
                for thread in threads
            ]
            page = {"pageInfo": {"hasNextPage": False, "endCursor": None}, "nodes": nodes}
            emit({"data": {"repository": {"pullRequest": {"reviewThreads": page}}}}, options)
        elif re.fullmatch(r"\s*(query\s*)?\{\s*viewer\s*\{\s*login\s*\}\s*\}\s*", document):
            emit({"data": {"viewer": {"login": state["viewer"]["login"]}}}, options)
        else:
            refuse("this GraphQL query is not served; gh pr view, gh repo view, gh search prs, and the REST endpoints carry the same data", op="graphql query")
        trace("read", op="graphql")
        return
    method = one(options, "method", "POST" if fields or options.get("input") else "GET").upper()
    if method != "GET":
        refuse("REST writes are outside the stand-in's contract; use gh pr comment, gh pr edit, gh pr merge, or gh label create", op="api write", method=method, endpoint=endpoint, fields=fields)
    query.update(fields)
    emit(api_get(state, endpoint, query, " ".join(options.get("header", []))), options)
    trace("read", op="api", endpoint=endpoint)


ISSUE_FIELDS = [("IFN_impact", "Impact"), ("IFN_confidence", "Confidence"), ("IFN_verification", "Verification effort"), ("IFN_undo", "Undo cost")]


def set_issue_fields(state: dict, state_path: Path, document: str, fields: dict, options: dict) -> None:
    """Apply setIssueFieldValue: each fieldId/numberValue pair names two variables."""
    issue_variable = re.search(r"issueId:\s*\$(\w+)", document)
    pairs = re.findall(r"fieldId:\s*\$(\w+)\s*,\s*numberValue:\s*\$(\w+)", document)
    if not issue_variable or not pairs:
        refuse("this setIssueFieldValue form is not served; pass issueId and each fieldId and numberValue as variables", op="graphql mutation", document=document)
    wanted = fields.get(issue_variable.group(1), "")
    target = next(((slug, number) for slug, repo in state["repos"].items() for number in repo.get("issues", {}) if issue_id(slug, number) == wanted), None)
    names = dict(ISSUE_FIELDS)
    if target is None or any(fields.get(field) not in names for field, _ in pairs):
        die('{"errors":[{"message":"Could not resolve to a node with the global id"}]}', 1, op="graphql setIssueFieldValue", document=document)
    values = {}
    for field, value in pairs:
        try:
            number = float(fields.get(value, ""))
        except ValueError:
            die(f'{{"errors":[{{"message":"Variable ${value} of type Float! was provided invalid value"}}]}}', 1, op="graphql setIssueFieldValue")
        values[names[fields[field]]] = int(number) if number.is_integer() else number
    slug, number = target
    issue = state["repos"][slug]["issues"][number]
    issue.setdefault("fields", {}).update(values)
    save_state(state, state_path)
    trace("write", op="set issue fields", repo=slug, number=number, values=values)
    emit({"data": {"setIssueFieldValue": {"issue": {"number": int(number)}}}}, options)


def api_get(state: dict, endpoint: str, query: dict, headers: str) -> object:
    login = state["viewer"]["login"]
    if endpoint == "user":
        return {"login": login, "type": "User"}
    if endpoint == "user/orgs":
        return [{"login": org} for org in state.get("orgs", [])]
    if endpoint == "search/issues":
        found = search(state, {}, [unquote_plus(query.get("q", ""))])
        return {"total_count": len(found), "incomplete_results": False, "items": [rest_pull(state, slug, number) for slug, number in found]}
    owner_repos = re.fullmatch(r"(?:orgs|users)/([^/]+)/repos|user/repos", endpoint)
    if owner_repos:
        if endpoint == "user/repos":
            wanted = query.get("affiliation", "owner,collaborator,organization_member").split(",")

            def affiliation(slug: str) -> str:
                owner = slug.split("/")[0]
                default = "owner" if owner == login else "organization_member" if owner in state.get("orgs", []) else "collaborator"
                return state["repos"][slug].get("affiliation", default)

            return [rest_repo(state, slug) for slug in state["repos"] if affiliation(slug) in wanted]
        return [rest_repo(state, slug) for slug in state["repos"] if slug.split("/")[0] == owner_repos.group(1)]
    match = re.fullmatch(r"repos/([^/]+/[^/]+)(?:/(.*))?", endpoint)
    if not match:
        refuse(f"endpoint {endpoint!r} is not served", op="api", endpoint=endpoint)
    slug, tail = match.group(1), match.group(2) or ""
    repo = require_repo(state, slug)
    pulls = repo.get("pulls", {})
    if tail == "":
        return rest_repo(state, slug)
    if tail == "labels":
        return repo.get("labels", [])
    if tail == "rulesets":
        return []
    if tail == "pulls":
        wanted = query.get("state", "open")
        return [rest_pull(state, slug, number) for number, pull in pulls.items() if wanted == "all" or (pull["state"] == "OPEN") == (wanted == "open")]
    if tail == "contents" or tail.startswith("contents/"):
        path = tail[len("contents/"):].rstrip("/")
        tree = repo.get("contents", {}).get(query.get("ref", repo["defaultBranch"]), {})
        if path in tree:
            if "raw" in headers:
                return tree[path]
            return {"type": "file", "path": path, "name": path.rsplit("/", 1)[-1], "encoding": "base64", "content": base64.b64encode(tree[path].encode()).decode()}
        prefix = f"{path}/" if path else ""
        children = sorted({name[len(prefix):].split("/")[0] for name in tree if name.startswith(prefix)})
        if children:
            return [{"name": child, "path": prefix + child, "type": "file" if prefix + child in tree else "dir"} for child in children]
        not_found(f"{path} at {query.get('ref', repo['defaultBranch'])}")
    match = re.fullmatch(r"(pulls|issues)/(\d+)(?:/(files|comments|commits|reviews|labels))?", tail)
    if match:
        kind, number, part = match.groups()
        if number in pulls:
            if part is None:
                return pulls[number].get("diff", "") if "diff" in headers else rest_pull(state, slug, number)
            if part == "files":
                return [{"filename": item["path"], "additions": item["additions"], "deletions": item["deletions"], "changes": item["additions"] + item["deletions"], "patch": "\n".join(item["patch"])} for item in diff_files(pulls[number].get("diff", ""))]
            if part == "comments" and kind == "issues":
                return [{"user": {"login": comment["author"]["login"]}, "body": comment["body"], "created_at": comment["createdAt"], "html_url": comment["url"]} for comment in pull_object(state, slug, number)["comments"]]
            if part == "commits":
                return [{"sha": commit["oid"], "commit": {"message": commit["messageHeadline"], "committer": {"date": commit["committedDate"]}}} for commit in pull_object(state, slug, number)["commits"]]
            if part == "labels":
                return pull_object(state, slug, number)["labels"]
            if part == "reviews":
                return [{"user": {"login": review["author"]["login"]}, "state": review["state"], "body": review.get("body", "")} for review in pulls[number].get("reviews", [])]
            return []
        issue = repo.get("issues", {}).get(number)
        if kind == "issues" and issue is not None:
            if part == "comments":
                return [{"user": {"login": comment["author"]}, "body": comment["body"], "created_at": comment["createdAt"]} for comment in issue.get("comments", [])]
            return {"number": int(number), "title": issue["title"], "body": issue.get("body", ""), "state": issue.get("state", "OPEN").lower(), "labels": label_objects(repo, issue.get("labels", []))}
        not_found(f"{slug}#{number}")
    match = re.fullmatch(r"commits/([0-9a-f]{7,40})/(check-runs|status)", tail)
    if match:
        sha, part = match.groups()
        pull = next((pull for pull in pulls.values() if pull["headRefOid"].startswith(sha)), None)
        merged = next((pull for pull in pulls.values() if (pull.get("mergeCommit") or "").startswith(sha)), None)
        if pull is None and merged is None:
            not_found(f"commit {sha}")
        checks = pull.get("checks", []) if pull else merged.get("mergeCommitChecks", [])
        if part == "check-runs":
            return {"total_count": len(checks), "check_runs": [{"name": check["name"], "status": check["status"].lower(), "conclusion": check.get("conclusion", "").lower() or None} for check in checks]}
        conclusions = {check.get("conclusion", "") for check in checks}
        return {"state": "failure" if "FAILURE" in conclusions else "pending" if "" in conclusions or not checks else "success", "statuses": []}
    match = re.fullmatch(r"compare/([0-9a-f]{7,40})\.\.\.([0-9a-f]{7,40})", tail)
    if match and match.group(1) == match.group(2):
        return {"status": "identical", "ahead_by": 0, "behind_by": 0, "files": []}
    if tail.startswith("branches/") and tail.endswith("/protection"):
        not_found("Branch not protected")
    refuse(f"endpoint {endpoint!r} is not served", op="api", endpoint=endpoint)
    return None


def main() -> None:
    if not ARGV or ARGV[0] in ("--version", "version"):
        print("gh version 2.104.0 (2026-11-12)")
        return
    if ARGV[0] in ("help", "--help", "-h") or ARGV[-1] in ("--help", "-h"):
        print(SUPPORTED)
        return
    state, state_path = load_state()
    command, rest = ARGV[0], ARGV[1:]
    if command == "auth" and rest[:1] == ["status"]:
        options, _ = parse(rest[1:], {"--hostname": "hostname", "--json": "json", "--jq": "jq", "-q": "jq"}, {"--active": "active", "-a": "active"})
        account = {"state": "success", "active": True, "host": "github.com", "login": state["viewer"]["login"], "tokenSource": "keyring", "scopes": "repo, read:org", "gitProtocol": "https"}
        emit({"hosts": {"github.com": [account]}}, options, fields=["hosts"], text=f"github.com\n  ✓ Logged in to github.com account {state['viewer']['login']} (keyring)")
        trace("read", op="auth status")
    elif command == "api":
        cmd_api(state, state_path, rest)
    elif command == "search":
        cmd_search(state, rest)
    elif command == "pr":
        cmd_pr(state, state_path, rest)
    elif command == "issue":
        cmd_issue(state, state_path, rest)
    elif command == "repo":
        cmd_repo(state, rest)
    elif command == "label":
        cmd_label(state, state_path, rest)
    else:
        refuse(f"`{command}` is outside the stand-in's contract", op=command)


if __name__ == "__main__":
    main()
