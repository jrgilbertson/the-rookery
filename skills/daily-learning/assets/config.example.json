{
  "version": 1,
  "vault": {
    "name": "example-vault",
    "git_backup_mirror": {
      "remote_url": "git@example.invalid:owner/example-vault-backup.git",
      "cache_dir": "$XDG_CACHE_HOME/the-rookery/daily-learning/vault-mirror.git"
    },
    "reference_note_paths": [
      "References/",
      "Readwise/"
    ],
    "queue_notes": [
      "To Explore.md",
      "Misc.md"
    ],
    "reference_tags": {
      "in_progress": "#reading",
      "completed": "#reviewed"
    }
  },
  "strategy_and_learning": {
    "personal_chief_of_staff_map": {
      "locator_kind": "host-file",
      "path": "$XDG_CONFIG_HOME/the-rookery/personal-chief-of-staff/sources.json",
      "allow_cross_mode_read": true
    }
  },
  "remote_environments": [
    {
      "name": "example-dev-host",
      "workspace_selector": "folder:daily-learning-readonly",
      "agent": "codex",
      "scan_timeout_minutes": 10
    }
  ],
  "automation_runs": {
    "repo_path": "$XDG_STATE_HOME/automation-runs"
  },
  "anki": {
    "connect_url": "http://127.0.0.1:8765"
  }
}
