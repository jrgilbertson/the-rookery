#!/usr/bin/env python3
"""A read-only `gh` stand-in that serves one fixture pull request.

The battery needs the skill under test to run its real fetch path. Handing the
skill files and telling it they were already fetched would test a different
program than the one that ships, so this stub answers the skill's fixed verb
set from a specimen directory instead.

Point it at a specimen with CMR_FIXTURE and put this directory first on PATH:

    CMR_FIXTURE=.../fixtures/prs/specimen-a PATH=.../fixtures/bin:$PATH

A specimen holds body.md (the description body as it stands now), diff.txt
(what `gh pr diff` prints), and forge.json (everything the GraphQL queries
return: state, refs, userContentEdits, reviews, reviewThreads, and the
pull request's top-level comments). A connection a specimen omits is served
as an empty one, which is what a real pull request without them returns.

Set CMR_GH_AUTH_FAIL to any non-empty value to serve the unauthenticated forge
instead: every `pr` and `api` invocation fails with a realistic auth error and
exit 4, and `gh auth status` reports not-logged-in and exits 1. A scenario that
needs the skill's degraded path gets it from an observed failure rather than
from an assertion about what the skill said.

Every verb is a read. Anything that would write, and any verb the skill is not
supposed to reach for, exits non-zero so a run that strays fails loudly rather
than passing on silence. The stub is deliberately no more permissive than real
`gh`, because a malformed fetch that passes here would fail in production:

- `pr view` without `--json` is rejected; real `gh` prints formatted text
  there, which is not what this stub serves.
- `--json` field names are checked against the served set, so a misspelled
  field fails instead of quietly reading back null.
- `api graphql` checks that each served connection's selection set actually
  requests the field the skill depends on (REQUIRED_GRAPHQL_FIELDS). This is
  a field-presence check, not a GraphQL parser: it keeps the stub honest about
  what a real response would contain without pretending to validate the query.
- `auth` serves only the read-only `status` subcommand; `login`, `logout`, and
  `refresh` write.
"""

import json
import os
import re
import sys

WRITE_VERBS = {
    "merge", "close", "reopen", "edit", "comment", "review", "create",
    "delete", "ready", "lock", "unlock", "transfer", "sync",
}

# Each served GraphQL connection, and the field its selection set must request
# for the fetched nodes to be usable. `isResolved` is the one SKILL.md calls
# out as non-optional; the other two carry the timestamps that order the
# review rounds and the description baseline.
REQUIRED_GRAPHQL_FIELDS = {
    "reviewThreads": ("isResolved", "path", "comments", "body"),
    "reviews": ("submittedAt", "state", "body", "commit"),
    "userContentEdits": ("editedAt",),
    "comments": ("body", "author"),
}

# `comments` names two different connections: the pull request's top-level
# conversation comments, and the per-thread comments nested inside
# reviewThreads. Only the first is served here, so a query that also names
# reviewThreads is reading the nested one and gets no top-level connection.
NESTED_WHEN_PRESENT = {"comments": "reviewThreads"}

AUTH_ERROR = "error: not authenticated. Run 'gh auth login' to authenticate."


def die(msg, code=1):
    sys.stderr.write(f"gh (fixture stub): {msg}\n")
    sys.exit(code)


def load():
    root = os.environ.get("CMR_FIXTURE")
    if not root:
        die("CMR_FIXTURE is not set; no specimen to serve", 4)
    if not os.path.isdir(root):
        die(f"CMR_FIXTURE does not name a directory: {root}", 4)
    try:
        with open(os.path.join(root, "forge.json")) as fh:
            forge = json.load(fh)
    except FileNotFoundError:
        die(f"specimen has no forge.json: {root}", 4)
    except json.JSONDecodeError as exc:
        die(f"forge.json is not valid JSON: {exc}", 4)

    def read(name):
        path = os.path.join(root, name)
        if not os.path.exists(path):
            return ""
        with open(path) as fh:
            return fh.read()

    forge["_body"] = read("body.md")
    forge["_diff"] = read("diff.txt")
    return forge


def pr_view(argv, forge):
    fields = None
    for i, a in enumerate(argv):
        if a == "--json" and i + 1 < len(argv):
            fields = [f.strip() for f in argv[i + 1].split(",") if f.strip()]
    full = {
        "number": forge.get("number"),
        "title": forge.get("title", ""),
        "body": forge.get("_body", ""),
        "state": forge.get("state", "OPEN"),
        "isDraft": forge.get("isDraft", False),
        "merged": forge.get("state") == "MERGED",
        "mergedAt": forge.get("mergedAt"),
        "author": {"login": forge.get("author", "")},
        "baseRefName": forge.get("baseRefName", "main"),
        "headRefName": forge.get("headRefName", ""),
        "headRefOid": forge.get("headRefOid", ""),
        "isCrossRepository": forge.get("isCrossRepository", False),
        "url": forge.get(
            "url",
            f"https://github.com/{forge.get('repo','')}/pull/{forge.get('number','')}",
        ),
        "files": forge.get("files", []),
    }
    if not fields:
        die(
            "`pr view` without --json prints formatted text on real gh; this "
            "stub serves only the JSON read the skill's fetch contract names",
            2,
        )
    unknown = [f for f in fields if f not in full]
    if unknown:
        die(
            "`pr view --json` names field(s) this stub does not serve: "
            f"{', '.join(unknown)}",
            2,
        )
    print(json.dumps({k: full[k] for k in fields}, indent=2))


def selection_set(query, connection):
    """Return the brace-balanced text a connection selects, or None.

    Deliberately not a parser: it finds the connection by name and walks its
    braces, which is enough to tell whether a field was actually requested.
    """
    match = re.search(rf"\b{connection}\b", query)
    if not match:
        return None
    start = query.find("{", match.end())
    if start == -1:
        return None
    depth = 0
    for i in range(start, len(query)):
        if query[i] == "{":
            depth += 1
        elif query[i] == "}":
            depth -= 1
            if depth == 0:
                return query[start:i + 1]
    return None


def paginate(forge, connection, query):
    """Serve one page of a connection, honouring `first:` and `after:`.

    Real GraphQL may return fewer nodes than `first:` asks for, so a specimen
    can set `pageSize` in its forge.json to cap the page below the requested
    count. That is what makes a connection span pages, which is the only way
    the skill's paginate-to-exhaustion contract can actually be tested: a
    single-page connection passes whether the run follows a cursor or not.
    """
    nodes = forge.get(connection, [])
    block_start = re.search(rf"\b{connection}\b", query).end()
    args = query[block_start:query.find("{", block_start)]

    first = re.search(r"first\s*:\s*(\d+)", args)
    first = int(first.group(1)) if first else len(nodes)
    cap = forge.get("pageSize")
    size = max(1, min(first, cap) if cap else first)

    after = re.search(r"after\s*:\s*(?:\"([^\"]*)\"|\$(\w+))", args)
    start = 0
    if after and after.group(1):
        cursor = after.group(1)
        if not cursor.startswith(f"{connection}:"):
            die(f"cursor {cursor!r} does not belong to `{connection}`", 2)
        try:
            start = int(cursor.split(":", 1)[1])
        except ValueError:
            die(f"cursor {cursor!r} is not one this stub issued", 2)
        if start > len(nodes):
            die(f"cursor {cursor!r} is past the end of `{connection}`", 2)

    page = nodes[start:start + size]
    end = start + len(page)
    has_next = end < len(nodes)
    return {
        "nodes": page,
        "pageInfo": {
            "hasNextPage": has_next,
            "endCursor": f"{connection}:{end}" if has_next else None,
        },
    }


def graphql(argv, forge):
    query = ""
    for i, a in enumerate(argv):
        if a in ("-f", "--field", "-F", "--raw-field") and i + 1 < len(argv):
            val = argv[i + 1]
            if val.startswith("query="):
                query = val[len("query="):]
        elif a.startswith("query="):
            query = a[len("query="):]
    if not query:
        die("no query= field supplied to `api graphql`", 2)

    pr = {}
    for connection, required in REQUIRED_GRAPHQL_FIELDS.items():
        if not re.search(rf"\b{connection}\b", query):
            continue
        outer = NESTED_WHEN_PRESENT.get(connection)
        if outer and re.search(rf"\b{outer}\b", query):
            continue
        block = selection_set(query, connection)
        if block is None:
            die(f"`{connection}` is named without a selection set", 2)
        missing = [f for f in required if not re.search(rf"\b{f}\b", block)]
        if missing:
            die(
                f"`{connection}` is requested without {', '.join(missing)}; "
                "a real response would omit the field the skill depends on",
                2,
            )
        pr[connection] = paginate(forge, connection, query)
    if not pr:
        die(
            "query names none of reviewThreads, reviews, userContentEdits, or the "
            "top-level comments connection; "
            "this stub serves only the skill's fixed read set",
            2,
        )
    pr.setdefault("number", forge.get("number"))
    print(json.dumps({"data": {"repository": {"pullRequest": pr}}}, indent=2))


def main():
    argv = sys.argv[1:]
    if not argv:
        die("no command", 2)

    unauthenticated = bool(os.environ.get("CMR_GH_AUTH_FAIL"))

    if argv[0] == "auth":
        if len(argv) < 2 or argv[1] != "status":
            die("only `auth status` is served; the rest of `auth` writes", 3)
        if unauthenticated:
            sys.stderr.write(
                "You are not logged into any GitHub hosts. "
                "To log in, run: gh auth login\n"
            )
            sys.exit(1)
        print("github.com\n  Logged in to github.com as fixture-owner")
        return
    if argv[0] == "repo" and len(argv) > 1 and argv[1] == "view":
        forge = load()
        print(json.dumps({"nameWithOwner": forge.get("repo", "")}, indent=2))
        return

    if argv[0] in ("pr", "api") and unauthenticated:
        sys.stderr.write(f"{AUTH_ERROR}\n")
        sys.exit(4)

    if argv[0] == "pr":
        if len(argv) < 2:
            die("`pr` needs a subcommand", 2)
        sub = argv[1]
        if sub in WRITE_VERBS:
            die(f"`pr {sub}` writes; this stub is read-only", 3)
        forge = load()
        if sub == "view":
            return pr_view(argv[2:], forge)
        if sub == "diff":
            sys.stdout.write(forge.get("_diff", ""))
            return
        die(f"`pr {sub}` is outside the skill's fixed read set", 3)

    if argv[0] == "api":
        if "graphql" not in argv[:3]:
            die("only `api graphql` is served", 3)
        return graphql(argv, load())

    die(f"`{argv[0]}` is outside the skill's fixed read set", 3)


if __name__ == "__main__":
    main()
