#!/usr/bin/env python3
"""Read-only `gh` stand-in that serves one constructed pull request.

The skill under test must run its real fetch path. This stub is that path's
fixture server — not a GraphQL simulator. Live GitHub (battery scenario 11)
is the only honest oracle for whether a query is well formed.

    CMR_FIXTURE=.../fixtures/prs/specimen-a PATH=.../fixtures/bin:$PATH

Specimen layout:
  body.md     current description
  diff.txt    `gh pr diff` output
  forge.json  state, refs, userContentEdits, reviews, reviewThreads, comments

Optional env:
  CMR_GH_AUTH_FAIL  non-empty → every pr/api call fails like an unauthenticated forge
  CMR_ISSUE_VIEW_FAIL  non-empty → linked issue lookup fails as unavailable

Contract (deliberately small):
  - serve only the skill's fixed read set: pr view --json (incl. merge state),
    pr diff, issue view --json for linked source-issue metadata, api graphql
    (history + linked-issue comments + branchProtectionRules + merge
    eligibility), and api repos/.../rules/branches/{base} for merge policy
  - refuse writes and out-of-set verbs unless CMR_ALLOW_MERGE is set, in
    which case `pr merge` is recorded and may return a specimen result
  - optional env:
      CMR_ALLOW_MERGE     non-empty → gated `pr merge` (still refuses
                          --admin/--auto/--delete-branch, extra tokens, and
                          missing method)
      CMR_MERGE_LOG       path to append one JSON object per merge attempt
                          (JSONL): argv and promptDisabled (GH_PROMPT_DISABLED)
      CMR_MERGE_STATE     path written as MERGED on success; pr view reads it.
                          A second merge while this is MERGED is already-merged
      CMR_MERGE_RESULT    merged (default) | failed | indeterminate |
                          already_merged
  - refuse a selector that names another pull request
  - refuse an under-fetch of fields the skill depends on (query-text presence)
  - paginate connections (first / after, including -f/-F variables)
  - do NOT project responses to selection sets; whole fixture nodes are returned
"""

import json
import os
import re
import sys
import tempfile

WRITE_VERBS = {
    "merge", "close", "reopen", "edit", "comment", "review", "create",
    "delete", "ready", "lock", "unlock", "transfer", "sync",
}

MERGE_METHODS = ("--merge", "--squash", "--rebase")
MERGE_FORBIDDEN = ("--admin", "--auto", "--delete-branch")
MERGE_METHOD_ELIG = {
    "--merge": "mergeCommitAllowed",
    "--squash": "squashMergeAllowed",
    "--rebase": "rebaseMergeAllowed",
}

PR_SELECTOR_RE = re.compile(
    r"^(?:https?://([^/]+)/)?([^/\s]+/[^/\s]+?)(?:\.git)?"
    r"(?:/pull/|#)(\d+)/?$"
)

# Cheap under-fetch guard aligned once to SKILL.md step 2's floor.
# Presence check only — not a parser, not a selection-set projector.
# Nested comments under reviewThreads reuses body/id/author tokens.
SERVED_CONNECTIONS = {
    "reviewThreads": (
        "id", "isResolved", "path", "comments", "body", "pullRequestReview",
        "pageInfo", "line",
    ),
    "reviews": (
        "id", "submittedAt", "state", "body", "commit", "author", "pageInfo",
    ),
    "userContentEdits": ("editedAt", "editor", "diff", "pageInfo"),
    "comments": ("id", "body", "author", "pageInfo"),
}

SCALAR_AS_OBJECT = {
    "author": "login",
    "editor": "login",
    "commit": "oid",
}

AUTH_ERROR = "error: not authenticated. Run 'gh auth login' to authenticate."


def die(msg, code=1):
    sys.stderr.write(f"gh (fixture stub): {msg}\n")
    sys.exit(code)


def load():
    root = os.environ.get("CMR_FIXTURE")
    if not root:
        die("CMR_FIXTURE is not set; no specimen to serve", 4)
    if not os.path.isdir(root):
        die(f"CMR_FIXTURE does not name a directory: {root}", 4)
    try:
        with open(os.path.join(root, "forge.json")) as fh:
            forge = json.load(fh)
    except FileNotFoundError:
        die(f"specimen has no forge.json: {root}", 4)
    except json.JSONDecodeError as exc:
        die(f"forge.json is not valid JSON: {exc}", 4)
    forge["_root"] = root
    return forge


def specimen_text(forge, name):
    path = os.path.join(forge["_root"], name)
    try:
        with open(path) as fh:
            return fh.read()
    except FileNotFoundError:
        return ""


def selector_check(argv, forge):
    """Fail when a selector names a pull request this specimen is not."""
    number = forge.get("number")
    repo = forge.get("repo", "")
    owner = repo.split("/")[0] if "/" in repo else repo

    want_number = None
    want_repo = None
    skip = False
    for i, a in enumerate(argv):
        if skip:
            skip = False
            continue
        if a == "--repo" and i + 1 < len(argv):
            want_repo = argv[i + 1]
            skip = True
            continue
        if a.startswith("-"):
            if a in ("--json", "-q", "--jq", "--template", "-t"):
                skip = True
            continue
        if want_number is not None:
            continue
        m = PR_SELECTOR_RE.match(a)
        if m:
            url_host, url_repo, url_number = m.group(1), m.group(2), int(m.group(3))
            if want_repo is None:
                want_repo = f"{url_host}/{url_repo}" if url_host else url_repo
            want_number = url_number
        elif a.isdigit():
            want_number = int(a)
        else:
            die(
                f"`{a}` is a selector this stub does not resolve; it serves "
                "one specimen, addressed by number, URL, or owner/name#number",
                3,
            )

    if want_number is not None and want_number != number:
        die(
            f"no pull request {want_number} here; this specimen is "
            f"{repo}#{number}",
            1,
        )
    if want_repo is not None:
        check_repo = split_host_repo(want_repo, forge)
        if check_repo not in (repo, owner):
            die(
                f"no pull request in {want_repo} here; this specimen is {repo}",
                1,
            )
    return want_number, want_repo


def pr_view(argv, forge):
    want_number, want_repo = selector_check(argv, forge)
    fields = None
    for i, a in enumerate(argv):
        if a == "--json" and i + 1 < len(argv):
            fields = [f.strip() for f in argv[i + 1].split(",") if f.strip()]
    full = {
        "number": forge.get("number"),
        "title": forge.get("title", ""),
        "body": specimen_text(forge, "body.md"),
        "state": forge.get("state", "OPEN"),
        "isDraft": forge.get("isDraft", False),
        "merged": forge.get("state") == "MERGED",
        "mergedAt": forge.get("mergedAt"),
        "author": {"login": forge.get("author", "")},
        "baseRefName": forge.get("baseRefName", "main"),
        "baseRefOid": forge.get("baseRefOid", ""),
        "headRefName": forge.get("headRefName", ""),
        "headRefOid": forge.get("headRefOid", ""),
        "isCrossRepository": forge.get("isCrossRepository", False),
        "url": forge.get(
            "url",
            f"https://github.com/{forge.get('repo', '')}/pull/{forge.get('number', '')}",
        ),
        "files": forge.get("files", []),
        "mergeable": forge.get("mergeable", "MERGEABLE"),
        "mergeStateStatus": forge.get("mergeStateStatus", "CLEAN"),
        "reviewDecision": forge.get("reviewDecision", ""),
        "statusCheckRollup": forge.get("statusCheckRollup", []),
        "closingIssuesReferences": forge.get("closingIssuesReferences", []),
        "mergeCommit": forge.get("mergeCommit"),
    }
    state_path = os.environ.get("CMR_MERGE_STATE")
    require_disposable_path(state_path, "CMR_MERGE_STATE")
    merged_overlay = already_merged_state(state_path)
    if merged_overlay:
        require_certified_merge_selector(want_number, want_repo, forge)
        full["state"] = "MERGED"
        full["merged"] = True
        full["mergedAt"] = forge.get("mergedAt") or "2026-08-25T00:00:00Z"
    log_path = os.environ.get("CMR_MERGE_LOG")
    if not fields:
        die(
            "`pr view` without --json prints formatted text on real gh; this "
            "stub serves only the JSON read the skill's fetch contract names",
            2,
        )
    unknown = [f for f in fields if f not in full]
    if unknown:
        die(
            "`pr view --json` names field(s) this stub does not serve: "
            f"{', '.join(unknown)}",
            2,
        )
    if log_path and want_number is not None and (
        merged_overlay or merge_log_has_attempt(log_path)
    ):
        require_disposable_path(log_path, "CMR_MERGE_LOG")
        with open(log_path, "a") as fh:
            json.dump({"kind": "view", "argv": list(argv)}, fh)
            fh.write("\n")
    print(json.dumps({k: full[k] for k in fields}, indent=2))


def issue_selector_check(argv, forge):
    """Resolve only the specimen's repository-local source issues."""
    issues = source_issues(forge)
    if not issues:
        die("this specimen has no linked source issue", 1)

    repo = forge.get("repo", "")
    forge_host = forge.get("host", "github.com").lower()
    want_number = None
    want_repo = None
    skip = False
    for i, a in enumerate(argv):
        if skip:
            skip = False
            continue
        if a in ("--repo", "-R") and i + 1 < len(argv):
            want_repo = argv[i + 1].removeprefix("github.com/")
            skip = True
            continue
        if a.startswith("-"):
            if a in ("--json", "-q", "--jq", "--template", "-t"):
                skip = True
            continue
        if want_number is not None:
            continue
        match = re.match(
            r"^(?:https?://([^/]+)/)?([^/\s]+/[^/\s]+?)(?:\.git)?"
            r"(?:/issues/|#)(\d+)/?$",
            a,
        )
        if match:
            selector_host = match.group(1)
            if selector_host is not None and selector_host.lower() != forge_host:
                die(
                    f"source-issue host {selector_host} does not match {forge_host}",
                    1,
                )
            want_repo = want_repo or match.group(2)
            want_number = int(match.group(3))
        elif a.isdigit():
            want_number = int(a)
        else:
            die(f"`{a}` is not a supported source-issue selector", 3)

    if want_number is None:
        die("`issue view` requires the linked issue number or URL", 2)
    normalized_repo = repo.removeprefix("github.com/")
    if want_repo is not None and want_repo != normalized_repo:
        die(f"no issue in {want_repo} here; this specimen is {repo}", 1)
    for issue in issues:
        if isinstance(issue, dict) and want_number == issue.get("number"):
            return issue
    served = ", ".join(
        str(issue.get("number")) for issue in issues if isinstance(issue, dict)
    )
    die(f"no issue {want_number} here; this specimen serves issues {served}", 1)


def issue_view(argv, forge):
    issue = issue_selector_check(argv, forge)
    fields = None
    for i, a in enumerate(argv):
        if a == "--json" and i + 1 < len(argv):
            fields = [f.strip() for f in argv[i + 1].split(",") if f.strip()]
    full = {
        "number": issue.get("number"),
        "title": issue.get("title", ""),
        "body": issue.get("body", ""),
        "state": issue.get("state", "OPEN"),
        "url": issue.get("url", ""),
    }
    if not fields:
        die("`issue view` requires --json for the skill's fixed read", 2)
    unknown = [field for field in fields if field not in full]
    if unknown:
        die(
            "`issue view --json` names field(s) this stub does not serve: "
            f"{', '.join(unknown)}",
            2,
        )
    print(json.dumps({key: full[key] for key in fields}, indent=2))


def normalise(value, field):
    if field in SCALAR_AS_OBJECT and isinstance(value, str):
        return {SCALAR_AS_OBJECT[field]: value}
    return value


def shape(node):
    out = {}
    for k, v in node.items():
        if isinstance(v, list):
            out[k] = [shape(n) for n in v]
        elif isinstance(v, dict):
            out[k] = shape(v)
        else:
            out[k] = normalise(v, k)
    return out


def connection_args(query, name, *, which="first"):
    """Return connection args for `name(...)`.

    which: "first" | "last" — combined GraphQL documents often nest
    `comments(` under reviewThreads and again at pullRequest level; the
    top-level conversation connection is the last occurrence.
    """
    matches = list(re.finditer(rf"\b{name}\s*\(([^)]*)\)", query))
    if not matches:
        return ""
    m = matches[-1] if which == "last" else matches[0]
    return m.group(1)


def field_bindings(argv):
    """Non-query -f/-F pairs so parameterized cursors match real `gh`."""
    bindings = {}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-f", "--field", "-F", "--raw-field") and i + 1 < len(argv):
            pair = argv[i + 1]
            i += 2
            if "=" not in pair:
                continue
            key, val = pair.split("=", 1)
            if key != "query":
                bindings[key] = val
            continue
        i += 1
    return bindings


def bound(name, bindings):
    if name not in bindings:
        die(
            f"variable ${name} is not bound; pass -f {name}=... or "
            f"-F {name}=...",
            2,
        )
    return bindings[name]


def source_issues(forge):
    issues = forge.get("sourceIssues")
    if isinstance(issues, list):
        return issues
    issue = forge.get("sourceIssue")
    return [issue] if isinstance(issue, dict) else []


def resolve_named_integer(args, field, bindings):
    literal = re.search(rf"\b{field}\s*:\s*(\d+)", args)
    if literal:
        return int(literal.group(1))
    variable = re.search(rf"\b{field}\s*:\s*\$(\w+)", args)
    if variable:
        raw = bound(variable.group(1), bindings)
        if not re.fullmatch(r"\d+", raw):
            die(
                f"variable ${variable.group(1)} is not a non-negative integer: {raw!r}",
                2,
            )
        return int(raw)
    die(f"`{field}` is required", 2)


def resolve_named_string(args, field, bindings):
    literal = re.search(rf'\b{field}\s*:\s*"([^"]+)"', args)
    if literal:
        return literal.group(1)
    variable = re.search(rf"\b{field}\s*:\s*\$(\w+)", args)
    if variable:
        value = bound(variable.group(1), bindings)
        if value:
            return value
        die(f"variable ${variable.group(1)} is empty", 2)
    die(f"`{field}` is required", 2)


def resolve_first(args, bindings):
    lit = re.search(r"first\s*:\s*(\d+)", args)
    if lit:
        return int(lit.group(1))
    var = re.search(r"first\s*:\s*\$(\w+)", args)
    if var:
        raw = bound(var.group(1), bindings)
        if not re.fullmatch(r"\d+", raw):
            die(
                f"variable ${var.group(1)} is not a non-negative integer: {raw!r}",
                2,
            )
        return int(raw)
    return None


def resolve_after(args, bindings):
    lit = re.search(r'after\s*:\s*"([^"]*)"', args)
    if lit:
        return lit.group(1)
    var = re.search(r"after\s*:\s*\$(\w+)", args)
    if var:
        return bound(var.group(1), bindings)
    return None


def page(nodes, args, scope, forge, bindings):
    first = resolve_first(args, bindings)
    if first is None:
        first = len(nodes)
    cap = forge.get("pageSize")
    size = min(first, cap) if cap else first

    start = 0
    cursor = resolve_after(args, bindings)
    if cursor is not None:
        prefix, _, offset = cursor.rpartition(":")
        if prefix != scope:
            die(f"cursor {cursor!r} was issued for `{prefix}`, not `{scope}`", 2)
        if not offset.isdigit():
            die(f"cursor {cursor!r} is not one this stub issued", 2)
        start = int(offset)
        if start > len(nodes):
            die(f"cursor {cursor!r} is past the end of `{scope}`", 2)

    window = nodes[start:start + size]
    end = start + len(window)
    return window, start, {
        "hasNextPage": end < len(nodes),
        "endCursor": f"{scope}:{end}" if end < len(nodes) else None,
    }


def branch_protection_payload(forge):
    rules = forge.get("branchProtectionRules")
    if rules is None:
        mr = forge.get("mergeRules") or {}
        rules = [
            {
                "pattern": forge.get("baseRefName", "main"),
                "requiresConversationResolution": bool(
                    mr.get("requiresConversationResolution", False)
                ),
                "requiredApprovingReviewCount": int(
                    mr.get("requiredApprovingReviewCount", 0)
                ),
                "requiresStatusChecks": bool(mr.get("requiresStatusChecks", False)),
                "requiredStatusCheckContexts": mr.get(
                    "requiredStatusCheckContexts", []
                ),
            }
        ]
    return {"nodes": rules}


def rules_branches_payload(forge):
    """Shape like GET /repos/{owner}/{repo}/rules/branches/{branch}."""
    mr = forge.get("mergeRules") or {}
    if not mr and "rulesBranches" in forge:
        return forge["rulesBranches"]
    if not mr:
        return []
    return [
        {
            "type": "pull_request",
            "parameters": {
                "required_approving_review_count": int(
                    mr.get("requiredApprovingReviewCount", 0)
                ),
                "dismiss_stale_reviews_on_push": bool(
                    mr.get("dismissStaleReviewsOnPush", False)
                ),
                "require_code_owner_review": bool(
                    mr.get("requireCodeOwnerReview", False)
                ),
                "require_last_push_approval": bool(
                    mr.get("requireLastPushApproval", False)
                ),
                "required_review_thread_resolution": bool(
                    mr.get("requiresConversationResolution", False)
                ),
            },
        }
    ]


def argv_option(argv, names, attached=(), default=None):
    for i, a in enumerate(argv):
        if a in names and i + 1 < len(argv):
            return argv[i + 1]
        for prefix in attached:
            if a.startswith(prefix) and len(a) > len(prefix):
                return a[len(prefix):]
    return default


def requested_api_host(argv):
    return argv_option(
        argv,
        ("--hostname",),
        attached=("--hostname=",),
        default=os.environ.get("GH_HOST") or "github.com",
    )


def has_input_fields(argv):
    for a in argv:
        if a in ("-f", "--field", "-F", "--raw-field", "--input", "-i"):
            return True
        if a.startswith(("--field=", "--raw-field=", "--input=", "query=")):
            return True
        if a.startswith("-f") and len(a) > 2 and not a.startswith("--"):
            return True
        if a.startswith("-F") and len(a) > 2:
            return True
        if a.startswith("-i") and len(a) > 2 and not a.startswith("--"):
            return True
    return False


def requested_http_method(argv):
    got = argv_option(
        argv,
        ("-X", "--method"),
        attached=("--method=", "-X"),
        default=None,
    )
    if got is not None:
        return got.upper()
    if has_input_fields(argv):
        return "POST"
    return "GET"


def require_disposable_path(path, label):
    if not path:
        return
    if os.path.lexists(path) and os.path.islink(path):
        die(f"{label} must not be a symlink", 3)
    tmp = os.path.realpath(tempfile.gettempdir())
    real = os.path.realpath(os.path.abspath(path))
    if real != tmp and not real.startswith(tmp + os.sep):
        die(f"{label} must be a temp-directory path", 3)


def split_host_repo(selector, forge):
    """Strip optional HOST/ from a repo selector. Refuse a mismatched host."""
    if selector.count("/") == 2:
        sel_host, rest = selector.split("/", 1)
        want = forge.get("host", "github.com").lower()
        if sel_host.lower() != want:
            die(f"host {sel_host} does not match {want}", 1)
        return rest
    return selector


def refuse_unless_api_host(argv, forge):
    got = requested_api_host(argv).lower()
    want = forge.get("host", "github.com").lower()
    if got != want:
        die(f"host {got} does not match {want}", 1)


def require_certified_pull_request_number(query, bindings, forge):
    number = resolve_named_integer(
        connection_args(query, "pullRequest"), "number", bindings
    )
    expected = forge.get("number")
    repo = forge.get("repo", "")
    if number != expected:
        die(
            f"no pull request {number} here; this specimen is "
            f"{repo}#{expected}",
            1,
        )


def refuse_unless_repository(requested_owner, requested_name, forge):
    expected_repository = forge.get("repo", "").removeprefix("github.com/")
    expected_owner, separator, expected_name = expected_repository.partition("/")
    if not separator or (
        requested_owner.lower(), requested_name.lower()
    ) != (expected_owner.lower(), expected_name.lower()):
        die(
            f"no repository {requested_owner}/{requested_name} here; "
            f"this specimen is {expected_repository}",
            1,
        )


def bind_certified_identity(query, argv, bindings, forge):
    """One GraphQL identity gate: host, then owner/name, then PR number."""
    refuse_unless_api_host(argv, forge)
    if re.search(r"\brepository\b", query) or re.search(r"\bpullRequest\b", query):
        repository_args = connection_args(query, "repository")
        refuse_unless_repository(
            resolve_named_string(repository_args, "owner", bindings),
            resolve_named_string(repository_args, "name", bindings),
            forge,
        )
    if re.search(r"\bpullRequest\b", query) or re.search(
        r"\bisMergeQueueEnabled\b", query
    ):
        require_certified_pull_request_number(query, bindings, forge)


def eligibility_fields(forge):
    raw = forge.get("mergeEligibility")
    if not isinstance(raw, dict):
        die(
            "this specimen has no mergeEligibility; eligibility probes "
            "fail closed",
            2,
        )
    return raw


def eligibility_value(elig, key):
    if key not in elig:
        die(
            f"mergeEligibility is missing `{key}`; fail closed rather than "
            "inventing a default",
            2,
        )
    return elig[key]


def parse_merge_argv(argv):
    """Allowlist: number or URL, --repo, one method flag, --match-head-commit."""
    forbidden = [f for f in MERGE_FORBIDDEN if f in argv]
    if forbidden:
        die(f"`pr merge` refuses {', '.join(forbidden)}", 3)
    method_flags = [f for f in MERGE_METHODS if f in argv]
    if len(method_flags) != 1:
        die("`pr merge` requires exactly one of --merge, --squash, --rebase", 2)

    want_number = None
    want_repo = None
    match_oid = None
    extras = []
    skip = False
    for i, a in enumerate(argv):
        if skip:
            skip = False
            continue
        if a in MERGE_METHODS:
            continue
        if a == "--repo" and i + 1 < len(argv):
            want_repo = argv[i + 1]
            skip = True
            continue
        if a == "--match-head-commit" and i + 1 < len(argv):
            match_oid = argv[i + 1]
            skip = True
            continue
        if a.startswith("-"):
            extras.append(a)
            continue
        m = PR_SELECTOR_RE.match(a)
        if m:
            if want_number is not None:
                die("`pr merge` accepts at most 1 arg(s), received 2", 2)
            url_host, url_repo, url_number = m.group(1), m.group(2), int(m.group(3))
            if want_repo is None:
                want_repo = f"{url_host}/{url_repo}" if url_host else url_repo
            want_number = url_number
            continue
        if a.isdigit():
            if want_number is not None:
                die("`pr merge` accepts at most 1 arg(s), received 2", 2)
            want_number = int(a)
            continue
        extras.append(a)
    if extras:
        die(
            f"`pr merge` refuses extra token(s) {', '.join(extras)}; "
            "allowlist is number, --repo, one method flag, --match-head-commit",
            3,
        )
    if not match_oid:
        die("`pr merge` requires --match-head-commit", 2)
    return want_number, want_repo, method_flags[0], match_oid


def require_certified_merge_selector(want_number, want_repo, forge):
    """Number and repo come from argv only; omitted selectors fail closed."""
    number = forge.get("number")
    repo = forge.get("repo", "")
    if want_number is None or want_repo is None:
        die(
            "`pr merge` requires a PR number (or URL) and repo; certified "
            "selectors are not taken from the specimen",
            2,
        )
    if want_number != number:
        die(
            f"no pull request {want_number} here; this specimen is "
            f"{repo}#{number}",
            1,
        )
    want_repo = split_host_repo(want_repo, forge)
    if want_repo != repo:
        die(
            f"no pull request in {want_repo} here; this specimen is {repo}",
            1,
        )


def refuse_unless_merge_eligible(method, forge):
    elig = eligibility_fields(forge)
    allowed_key = MERGE_METHOD_ELIG[method]
    if not eligibility_value(elig, allowed_key):
        die(
            f"`pr merge` refuses {method}; `{allowed_key}` is not allowed",
            1,
        )
    if eligibility_value(elig, "isMergeQueueEnabled"):
        die("`pr merge` refuses a merge-queue-governed pull request", 1)
    if "mergeQueue" in elig and elig["mergeQueue"] is not None:
        die("`pr merge` refuses a merge-queue-governed pull request", 1)


def merge_log_has_attempt(log_path):
    if not log_path:
        return False
    try:
        with open(log_path) as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    row = json.loads(line)
                except json.JSONDecodeError:
                    continue
                if row.get("kind") == "merge" or (
                    row.get("kind") is None and isinstance(row.get("argv"), list)
                ):
                    return True
    except FileNotFoundError:
        return False
    return False


def already_merged_state(state_path):
    if not state_path:
        return False
    try:
        with open(state_path) as fh:
            return fh.read().strip() == "MERGED"
    except FileNotFoundError:
        return False


def pr_merge(argv):
    if not os.environ.get("CMR_ALLOW_MERGE"):
        die("`pr merge` writes; this stub is read-only", 3)
    log_path = os.environ.get("CMR_MERGE_LOG")
    state_path = os.environ.get("CMR_MERGE_STATE")
    require_disposable_path(log_path, "CMR_MERGE_LOG")
    require_disposable_path(state_path, "CMR_MERGE_STATE")
    if log_path:
        with open(log_path, "a") as fh:
            json.dump(
                {
                    "kind": "merge",
                    "argv": list(argv),
                    "promptDisabled": os.environ.get("GH_PROMPT_DISABLED"),
                },
                fh,
            )
            fh.write("\n")
    forge = load()
    want_number, want_repo, method, match_oid = parse_merge_argv(argv)
    require_certified_merge_selector(want_number, want_repo, forge)
    expected = forge.get("headRefOid")
    if match_oid != expected:
        die(f"head OID {match_oid} does not match {expected}", 1)
    refuse_unless_merge_eligible(method, forge)
    result = os.environ.get("CMR_MERGE_RESULT", "merged")
    if already_merged_state(state_path) or result == "already_merged":
        if state_path:
            with open(state_path, "w") as fh:
                fh.write("MERGED\n")
        die("pull request is already merged", 1)
    if result == "merged":
        if state_path:
            with open(state_path, "w") as fh:
                fh.write("MERGED\n")
        print(f"Merged pull request {forge.get('number')}")
        return
    if result == "failed":
        die("pull request is not mergeable", 1)
    die("merge result could not be classified", 1)


def graphql(argv, forge):
    query = ""
    for i, a in enumerate(argv):
        val = None
        if a in ("-f", "--field", "-F", "--raw-field") and i + 1 < len(argv):
            val = argv[i + 1]
        elif a.startswith("query="):
            val = a
        if val and val.startswith("query="):
            query = val[len("query="):]
    if not query:
        die("no query= field supplied to `api graphql`", 2)
    # Reject any document that declares a mutation operation (named or not),
    # including after fragment definitions.
    if re.search(r"(?m)^\s*mutation\b", query) or re.search(
        r"\bmutation\s+[A-Za-z_]", query
    ) or re.search(r"\bmutation\s*[({]", query):
        die("`mutation` is a write; this stub serves queries only", 3)

    bindings = field_bindings(argv)
    bind_certified_identity(query, argv, bindings, forge)
    nested_comment_args = connection_args(query, "comments", which="first")
    top_comment_args = connection_args(query, "comments", which="last")
    serves_pull_request = bool(re.search(r"\bpullRequest\b", query))
    pr, served_pr = {}, False
    for name, required in SERVED_CONNECTIONS.items():
        if not serves_pull_request:
            break
        if not re.search(rf"\b{name}\b", query):
            continue
        # Nested `comments(` under reviewThreads is not the top-level
        # conversation connection. Serve top-level comments when requested
        # without threads, or when a second `comments(` appears alongside
        # threads (combined query). A single `comments(` with threads only
        # is the nested page — do not also dump forge["comments"].
        if name == "comments":
            n_comments = len(re.findall(r"\bcomments\s*\(", query))
            if re.search(r"\breviewThreads\b", query) and n_comments < 2:
                continue
            args = top_comment_args
        else:
            args = connection_args(query, name)
        missing = [f for f in required if not re.search(rf"\b{f}\b", query)]
        if missing:
            die(
                f"`{name}` is requested without {', '.join(missing)}; a real "
                "response would omit what the skill depends on",
                2,
            )
        nodes, start, info = page(
            forge.get(name, []), args, name, forge, bindings
        )
        out = []
        for i, node in enumerate(nodes, start=start):
            raw_comments = node.get("comments")
            if name == "reviewThreads" and isinstance(raw_comments, list):
                inner, _, inner_info = page(
                    raw_comments,
                    nested_comment_args,
                    f"reviewThreads[{i}].comments",
                    forge,
                    bindings,
                )
                node = shape({**node, "comments": inner})
                node["comments"] = {"nodes": node["comments"], "pageInfo": inner_info}
            else:
                node = shape(node)
            out.append(node)
        pr[name] = {"nodes": out, "pageInfo": info}
        served_pr = True

    served_issue = bool(re.search(r"\bissue\s*\(", query))
    issue_payload = None
    if served_issue:
        issue_fields = ("number", "title", "body", "state", "url")
        missing = [field for field in issue_fields if not re.search(rf"\b{field}\b", query)]
        comment_fields = ("id", "body", "author", "createdAt", "pageInfo")
        missing += [
            field
            for field in comment_fields
            if not re.search(rf"\b{field}\b", query)
        ]
        if missing:
            die(
                "`issue` is requested without " + ", ".join(missing) +
                "; a real response would omit what the skill depends on",
                2,
            )
        issue_number = resolve_named_integer(
            connection_args(query, "issue"), "number", bindings
        )
        issue = next(
            (
                candidate
                for candidate in source_issues(forge)
                if candidate.get("number") == issue_number
            ),
            None,
        )
        if issue is None:
            die(f"no source issue {issue_number} in this specimen", 1)
        comment_nodes, _, comment_info = page(
            issue.get("comments", []),
            connection_args(query, "comments", which="last"),
            f"issue[{issue_number}].comments",
            forge,
            bindings,
        )
        issue_payload = {
            field: issue.get(field, "")
            for field in issue_fields
        }
        issue_payload["comments"] = {
            "nodes": [shape(node) for node in comment_nodes],
            "pageInfo": comment_info,
        }

    served_protection = bool(re.search(r"\bbranchProtectionRules\b", query))
    served_eligibility = bool(
        re.search(
            r"\b(mergeCommitAllowed|squashMergeAllowed|rebaseMergeAllowed|"
            r"viewerDefaultMergeMethod|isMergeQueueEnabled|mergeQueue)\b",
            query,
        )
    )
    if (
        not served_pr
        and not served_issue
        and not served_protection
        and not served_eligibility
    ):
        die(
            "query names none of reviewThreads, reviews, userContentEdits, "
            "the top-level comments connection, issue comments, "
            "branchProtectionRules, or merge eligibility; "
            "this stub serves only the skill's fixed read set",
            2,
        )

    repo = {}
    elig = eligibility_fields(forge) if served_eligibility else None
    if served_pr:
        pr.setdefault("number", forge.get("number"))
        if re.search(r"\bisMergeQueueEnabled\b", query):
            pr["isMergeQueueEnabled"] = eligibility_value(
                elig, "isMergeQueueEnabled"
            )
        repo["pullRequest"] = pr
    if served_issue:
        repo["issue"] = issue_payload
    if served_protection:
        repo["branchProtectionRules"] = branch_protection_payload(forge)
    if served_eligibility:
        for key in (
            "mergeCommitAllowed",
            "squashMergeAllowed",
            "rebaseMergeAllowed",
            "viewerDefaultMergeMethod",
        ):
            if re.search(rf"\b{key}\b", query):
                repo[key] = eligibility_value(elig, key)
        if re.search(r"\bmergeQueue\b", query):
            args = connection_args(query, "mergeQueue")
            if not args:
                die(
                    "`mergeQueue` requires branch bound to the specimen "
                    "baseRefName; fail closed",
                    2,
                )
            branch = resolve_named_string(args, "branch", bindings)
            base = forge.get("baseRefName")
            if not base or branch != base:
                die(
                    f"`mergeQueue` branch {branch!r} is not this specimen's "
                    f"base {base!r}; fail closed",
                    1,
                )
            repo["mergeQueue"] = eligibility_value(elig, "mergeQueue")
        if re.search(r"\bisMergeQueueEnabled\b", query) and "pullRequest" not in repo:
            repo["pullRequest"] = {
                "isMergeQueueEnabled": eligibility_value(
                    elig, "isMergeQueueEnabled"
                )
            }
    print(json.dumps({"data": {"repository": repo}}, indent=2))


def api_rest(argv, forge):
    """Serve GET repos/.../rules/branches/{base} (gather host policy)."""
    method = requested_http_method(argv)
    if method != "GET":
        die(
            f"`gh api` REST eligibility reads are GET; {method} is a write",
            3,
        )
    path = None
    for a in argv:
        if a.startswith("repos/"):
            path = a.split("?", 1)[0].rstrip("/")
            break
    outside = (
        "only `api graphql` and "
        "`api repos/.../rules/branches/{base}` are served"
    )
    if path is None:
        die(outside, 3)
    parts = path.split("/")
    if (
        "/rules/branches/" not in path
        or len(parts) < 6
        or parts[0] != "repos"
    ):
        die(outside, 3)
    refuse_unless_api_host(argv, forge)
    refuse_unless_repository(parts[1], parts[2], forge)
    # The branch in the path must be the one this specimen merges into;
    # a real forge answers a rules read for any other branch with a 404.
    base = forge.get("baseRefName", "main")
    want = path.partition("/rules/branches/")[2]
    if want != base:
        die(
            f"Not Found (HTTP 404): no branch rules for `{want}` here; "
            f"this specimen merges into `{base}`",
            1,
        )
    print(json.dumps(rules_branches_payload(forge), indent=2))


def main():
    argv = sys.argv[1:]
    if not argv:
        die("no command", 2)

    unauthenticated = bool(os.environ.get("CMR_GH_AUTH_FAIL"))

    if argv[0] == "auth":
        if len(argv) < 2 or argv[1] != "status":
            die("only `auth status` is served; the rest of `auth` writes", 3)
        if unauthenticated:
            sys.stderr.write(
                "You are not logged into any GitHub hosts. "
                "To log in, run: gh auth login\n"
            )
            sys.exit(1)
        print("github.com\n  Logged in to github.com as fixture-owner")
        return

    if argv[0] == "repo":
        die("`repo` is outside the skill's fixed read set", 3)

    if argv[0] in ("pr", "issue", "api") and unauthenticated:
        sys.stderr.write(f"{AUTH_ERROR}\n")
        sys.exit(4)

    if argv[0] == "pr":
        if len(argv) < 2:
            die("`pr` needs a subcommand", 2)
        sub = argv[1]
        if sub == "merge":
            return pr_merge(argv[2:])
        if sub in WRITE_VERBS:
            die(f"`pr {sub}` writes; this stub is read-only", 3)
        forge = load()
        if sub == "view":
            return pr_view(argv[2:], forge)
        if sub == "diff":
            selector_check(argv[2:], forge)
            sys.stdout.write(specimen_text(forge, "diff.txt"))
            return
        die(f"`pr {sub}` is outside the skill's fixed read set", 3)

    if argv[0] == "issue":
        if len(argv) < 2:
            die("`issue` needs a subcommand", 2)
        sub = argv[1]
        if sub in WRITE_VERBS:
            die(f"`issue {sub}` writes; this stub is read-only", 3)
        if sub == "view" and os.environ.get("CMR_ISSUE_VIEW_FAIL"):
            die("linked issue is temporarily unavailable", 4)
        forge = load()
        if sub == "view":
            return issue_view(argv[2:], forge)
        die(f"`issue {sub}` is outside the skill's fixed read set", 3)

    if argv[0] == "api":
        forge = load()
        if "graphql" in argv:
            return graphql(argv, forge)
        return api_rest(argv[1:], forge)

    die(f"`{argv[0]}` is outside the skill's fixed read set", 3)


if __name__ == "__main__":
    main()
