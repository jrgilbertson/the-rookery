#!/usr/bin/env python3
"""A read-only `gh` stand-in that serves one fixture pull request.

The battery needs the skill under test to run its real fetch path. Handing the
skill files and telling it they were already fetched would test a different
program than the one that ships, so this stub answers the skill's fixed verb
set from a specimen directory instead.

Point it at a specimen with CMR_FIXTURE and put this directory first on PATH:

    CMR_FIXTURE=.../fixtures/prs/specimen-a PATH=.../fixtures/bin:$PATH

A specimen holds body.md (the description body as it stands now), diff.txt
(what `gh pr diff` prints), and forge.json (everything the GraphQL queries
return: state, refs, userContentEdits, reviews, reviewThreads, and the
pull request's top-level comments). A connection a specimen omits is served
as an empty one, which is what a real pull request without them returns.

Set CMR_GH_AUTH_FAIL to any non-empty value to serve the unauthenticated forge
instead: every `pr` and `api` invocation fails with a realistic auth error and
exit 4, and `gh auth status` reports not-logged-in and exits 1. A scenario that
needs the skill's degraded path gets it from an observed failure rather than
from an assertion about what the skill said.

Every verb is a read. Anything that would write, and any verb the skill is not
supposed to reach for, exits non-zero so a run that strays fails loudly rather
than passing on silence. The stub is deliberately no more permissive than real
`gh`, because a malformed fetch that passes here would fail in production:

- `pr view` without `--json` is rejected; real `gh` prints formatted text
  there, which is not what this stub serves.
- `--json` field names are checked against the served set, so a misspelled
  field fails instead of quietly reading back null.
- `api graphql` parses the query's selection set and returns only the fields
  it selected. Serving a whole fixture node regardless of the query is how a
  malformed fetch passes here and fails against real GitHub, so the projector
  exists to make the response no larger than what was asked for.
- Each served connection also declares the selection paths the skill depends
  on (REQUIRED_GRAPHQL_PATHS). A query that omits one fails loudly instead of
  quietly reading back null.
- A connection's `first` and `after` are honoured, including when supplied as
  query variables bound with `-f`/`-F`. An unbound variable fails rather than
  silently paging from the start. A specimen's `pageSize` caps every page,
  nested connections included, which is what makes a fixture span pages.
- `auth` serves only the read-only `status` subcommand; `login`, `logout`, and
  `refresh` write.
"""

import json
import os
import re
import sys

WRITE_VERBS = {
    "merge", "close", "reopen", "edit", "comment", "review", "create",
    "delete", "ready", "lock", "unlock", "transfer", "sync",
}

# Each served connection, and the selection paths SKILL.md step 2 says the
# digest depends on. These are paths rather than bare field names because a
# `body` anywhere under `reviewThreads` is not the same claim as a body on
# each thread comment: the first is satisfied by a thread-level field that is
# always null, the second is the review text the digest actually reads.
REQUIRED_GRAPHQL_PATHS = {
    "reviewThreads": (
        "nodes.isResolved",
        "nodes.path",
        "nodes.comments.nodes.body",
        "nodes.comments.nodes.pullRequestReview.submittedAt",
    ),
    "reviews": (
        "nodes.submittedAt",
        "nodes.state",
        "nodes.body",
        "nodes.commit",
    ),
    "userContentEdits": ("nodes.editedAt",),
    "comments": ("nodes.body", "nodes.author"),
}

# The only arguments this stub honours on a connection. Anything else would be
# accepted and ignored, which is the silent-wrong-data shape the projector
# exists to prevent, so an unknown argument fails instead.
CONNECTION_ARGS = {"first", "after"}

AUTH_ERROR = "error: not authenticated. Run 'gh auth login' to authenticate."


def die(msg, code=1):
    sys.stderr.write(f"gh (fixture stub): {msg}\n")
    sys.exit(code)


def load():
    root = os.environ.get("CMR_FIXTURE")
    if not root:
        die("CMR_FIXTURE is not set; no specimen to serve", 4)
    if not os.path.isdir(root):
        die(f"CMR_FIXTURE does not name a directory: {root}", 4)
    try:
        with open(os.path.join(root, "forge.json")) as fh:
            forge = json.load(fh)
    except FileNotFoundError:
        die(f"specimen has no forge.json: {root}", 4)
    except json.JSONDecodeError as exc:
        die(f"forge.json is not valid JSON: {exc}", 4)

    def read(name):
        path = os.path.join(root, name)
        if not os.path.exists(path):
            return ""
        with open(path) as fh:
            return fh.read()

    forge["_body"] = read("body.md")
    forge["_diff"] = read("diff.txt")
    return forge


def selector_check(argv, forge):
    """Fail when a selector names a pull request this specimen is not.

    The stub serves exactly one pull request, so a selector is either absent
    (the caller means this one) or has to agree with it. Serving the specimen
    for `pr view 999999 --repo entirely/wrong` would let the battery pass a
    run that fetched the wrong pull request in production.
    """
    number = forge.get("number")
    repo = forge.get("repo", "")
    owner = repo.split("/")[0] if "/" in repo else repo

    want_number = None
    want_repo = None
    skip = False
    for i, a in enumerate(argv):
        if skip:
            skip = False
            continue
        if a == "--repo" and i + 1 < len(argv):
            want_repo = argv[i + 1]
            skip = True
            continue
        if a.startswith("-"):
            if a in ("--json", "-q", "--jq", "--template", "-t"):
                skip = True
            continue
        if want_number is not None:
            continue
        m = re.match(r"^(?:https?://[^/]+/)?([^/\s]+/[^/\s]+?)(?:\.git)?"
                     r"(?:/pull/|#)(\d+)/?$", a)
        if m:
            want_repo = want_repo or m.group(1)
            want_number = int(m.group(2))
        elif a.isdigit():
            want_number = int(a)
        else:
            die(
                f"`{a}` is a selector this stub does not resolve; it serves "
                "one specimen, addressed by number, URL, or owner/name#number",
                3,
            )

    if want_number is not None and want_number != number:
        die(
            f"no pull request {want_number} here; this specimen is "
            f"{repo}#{number}",
            1,
        )
    if want_repo is not None:
        # The battery prompt names the owner, and recorded runs passed
        # `--repo mapleworks`, so the owner alone agrees. Anything else has to
        # match the specimen's full owner/name.
        if want_repo.count("/") == 2:
            want_repo = want_repo.split("/", 1)[1]
        if want_repo not in (repo, owner):
            die(f"no pull request in {want_repo} here; this specimen is {repo}", 1)


def pr_view(argv, forge):
    selector_check(argv, forge)
    fields = None
    for i, a in enumerate(argv):
        if a == "--json" and i + 1 < len(argv):
            fields = [f.strip() for f in argv[i + 1].split(",") if f.strip()]
    full = {
        "number": forge.get("number"),
        "title": forge.get("title", ""),
        "body": forge.get("_body", ""),
        "state": forge.get("state", "OPEN"),
        "isDraft": forge.get("isDraft", False),
        "merged": forge.get("state") == "MERGED",
        "mergedAt": forge.get("mergedAt"),
        "author": {"login": forge.get("author", "")},
        "baseRefName": forge.get("baseRefName", "main"),
        "headRefName": forge.get("headRefName", ""),
        "headRefOid": forge.get("headRefOid", ""),
        "isCrossRepository": forge.get("isCrossRepository", False),
        "url": forge.get(
            "url",
            f"https://github.com/{forge.get('repo','')}/pull/{forge.get('number','')}",
        ),
        "files": forge.get("files", []),
    }
    if not fields:
        die(
            "`pr view` without --json prints formatted text on real gh; this "
            "stub serves only the JSON read the skill's fetch contract names",
            2,
        )
    unknown = [f for f in fields if f not in full]
    if unknown:
        die(
            "`pr view --json` names field(s) this stub does not serve: "
            f"{', '.join(unknown)}",
            2,
        )
    print(json.dumps({k: full[k] for k in fields}, indent=2))


# The four connections this stub serves, and the field names a query has to
# name for the fetched nodes to be usable. This is a presence check on the
# query text, not a parser: the stub deliberately does not simulate GraphQL.
# Live GitHub is the only honest oracle for whether a query is well formed,
# which is scenario 11's job. What this catches is the cheap, high-value case
# of a run under-fetching against a constructed specimen.
SERVED_CONNECTIONS = {
    "reviewThreads": ("isResolved", "path", "comments", "body"),
    "reviews": ("submittedAt", "state", "body", "commit"),
    "userContentEdits": ("editedAt",),
    "comments": ("body", "author"),
}

# A fixture stores these as plain strings; the real API returns an object, so
# responses are normalised on the way out rather than fixtures being written
# in a shape no one can read.
SCALAR_AS_OBJECT = {"author": "login", "editor": "login", "commit": "oid",
                    "pullRequestReview": None}


def normalise(value, field):
    if field in SCALAR_AS_OBJECT and isinstance(value, str):
        return {SCALAR_AS_OBJECT[field]: value}
    return value


def shape(node):
    """A fixture node as the API would return it."""
    out = {}
    for k, v in node.items():
        if isinstance(v, list):
            out[k] = [shape(n) for n in v]
        elif isinstance(v, dict):
            out[k] = shape(v)
        else:
            out[k] = normalise(v, k)
    return out


def connection_args(query, name):
    m = re.search(rf"\b{name}\s*\(([^)]*)\)", query)
    return m.group(1) if m else ""


def page(nodes, args, scope, forge):
    """One page of a connection, honouring first, after, and the page cap."""
    first = re.search(r"first\s*:\s*(\d+)", args)
    first = int(first.group(1)) if first else len(nodes)
    cap = forge.get("pageSize")
    size = min(first, cap) if cap else first

    start = 0
    after = re.search(r'after\s*:\s*"([^"]*)"', args)
    if after:
        cursor = after.group(1)
        prefix, _, offset = cursor.rpartition(":")
        if prefix != scope:
            die(f"cursor {cursor!r} was issued for `{prefix}`, not `{scope}`", 2)
        if not offset.isdigit():
            die(f"cursor {cursor!r} is not one this stub issued", 2)
        start = int(offset)
        if start > len(nodes):
            die(f"cursor {cursor!r} is past the end of `{scope}`", 2)

    window = nodes[start:start + size]
    end = start + len(window)
    return window, start, {
        "hasNextPage": end < len(nodes),
        "endCursor": f"{scope}:{end}" if end < len(nodes) else None,
    }


def graphql(argv, forge):
    query = ""
    for i, a in enumerate(argv):
        val = argv[i + 1] if a in ("-f", "--field", "-F", "--raw-field") \
            and i + 1 < len(argv) else (a if a.startswith("query=") else None)
        if val and val.startswith("query="):
            query = val[len("query="):]
    if not query:
        die("no query= field supplied to `api graphql`", 2)
    if re.match(r"\s*(?:#[^\n]*\n\s*)*mutation\b", query) or \
            re.search(r"\bmutation\s*[({]", query):
        die("`mutation` is a write; this stub serves queries only", 3)

    comment_args = connection_args(query, "comments")
    pr, served = {}, False
    for name, required in SERVED_CONNECTIONS.items():
        if not re.search(rf"\b{name}\b", query):
            continue
        # `comments` names both the top-level connection and the one nested in
        # each thread; a query naming reviewThreads is reading the nested one.
        if name == "comments" and re.search(r"\breviewThreads\b", query):
            continue
        args = connection_args(query, name)
        missing = [f for f in required if not re.search(rf"\b{f}\b", query)]
        if missing:
            die(
                f"`{name}` is requested without {', '.join(missing)}; a real "
                "response would omit what the skill depends on",
                2,
            )
        nodes, start, info = page(forge.get(name, []), args, name, forge)
        out = []
        for i, node in enumerate(nodes, start=start):
            node = shape(node)
            if name == "reviewThreads" and isinstance(node.get("comments"), list):
                inner, _, inner_info = page(
                    node["comments"], comment_args,
                    f"reviewThreads[{i}].comments", forge)
                node["comments"] = {"nodes": inner, "pageInfo": inner_info}
            out.append(node)
        pr[name] = {"nodes": out, "pageInfo": info}
        served = True

    if not served:
        die(
            "query names none of reviewThreads, reviews, userContentEdits, or "
            "the top-level comments connection; this stub serves only the "
            "skill's fixed read set",
            2,
        )
    pr.setdefault("number", forge.get("number"))
    print(json.dumps({"data": {"repository": {"pullRequest": pr}}}, indent=2))


def main():
    argv = sys.argv[1:]
    if not argv:
        die("no command", 2)

    unauthenticated = bool(os.environ.get("CMR_GH_AUTH_FAIL"))

    if argv[0] == "auth":
        if len(argv) < 2 or argv[1] != "status":
            die("only `auth status` is served; the rest of `auth` writes", 3)
        if unauthenticated:
            sys.stderr.write(
                "You are not logged into any GitHub hosts. "
                "To log in, run: gh auth login\n"
            )
            sys.exit(1)
        print("github.com\n  Logged in to github.com as fixture-owner")
        return
    if argv[0] == "repo" and len(argv) > 1 and argv[1] == "view":
        forge = load()
        print(json.dumps({"nameWithOwner": forge.get("repo", "")}, indent=2))
        return

    if argv[0] in ("pr", "api") and unauthenticated:
        sys.stderr.write(f"{AUTH_ERROR}\n")
        sys.exit(4)

    if argv[0] == "pr":
        if len(argv) < 2:
            die("`pr` needs a subcommand", 2)
        sub = argv[1]
        if sub in WRITE_VERBS:
            die(f"`pr {sub}` writes; this stub is read-only", 3)
        forge = load()
        if sub == "view":
            return pr_view(argv[2:], forge)
        if sub == "diff":
            selector_check(argv[2:], forge)
            sys.stdout.write(forge.get("_diff", ""))
            return
        die(f"`pr {sub}` is outside the skill's fixed read set", 3)

    if argv[0] == "api":
        if "graphql" not in argv[:3]:
            die("only `api graphql` is served", 3)
        return graphql(argv, load())

    die(f"`{argv[0]}` is outside the skill's fixed read set", 3)


if __name__ == "__main__":
    main()
