            "submittedAt": "2026-07-14T10:20:00Z",
            "state": "CHANGES_REQUESTED"
          }
        },
        {
          "id": "PRRC_c0_1",
          "author": "lsorel",
          "createdAt": "2026-07-14T16:02:00Z",
          "body": "Agreed \u2014 switched to write-triggered invalidation for the products cache; TTL stays as a backstop.",
          "pullRequestReview": {
