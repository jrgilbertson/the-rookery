#!/usr/bin/env python3
"""Small stateful gh fixture for managing-issues command-contract tests."""

from __future__ import annotations

import hashlib
import json
import os
import sys
from pathlib import Path
from typing import Any


ARGV = sys.argv[1:]
STATE_PATH = Path(os.environ["MI_GITHUB_STATE"])
LOG_PATH = Path(os.environ["MI_GITHUB_LOG"])
STDIN = sys.stdin.read() if "--body-file" in ARGV else ""


def emit(value: Any) -> None:
    print(json.dumps(value, separators=(",", ":"), sort_keys=True))


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def flag(name: str, default: str | None = None) -> str | None:
    try:
        return ARGV[ARGV.index(name) + 1]
    except (ValueError, IndexError):
        return default


def load() -> dict[str, Any]:
    return json.loads(STATE_PATH.read_text(encoding="utf-8"))


def save(state: dict[str, Any]) -> None:
    temporary = STATE_PATH.with_name(f"{STATE_PATH.name}.tmp")
    temporary.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(STATE_PATH)


def issue_number(value: str) -> str:
    return value.rstrip("/").rsplit("/", 1)[-1]


def body_from_stdin() -> str:
    if flag("--body-file") != "-":
        fail("fixture requires --body-file -")
    return STDIN


def issue_ref(issue: dict[str, Any]) -> dict[str, Any]:
    return {"id": issue["id"], "number": issue["number"]}


def add_unique_ref(items: list[dict[str, Any]], issue: dict[str, Any]) -> None:
    if not any(candidate["id"] == issue["id"] for candidate in items):
        items.append(issue_ref(issue))


def remove_ref(items: list[dict[str, Any]], issue: dict[str, Any]) -> None:
    items[:] = [candidate for candidate in items if candidate["id"] != issue["id"]]


def api_issue_and_collection(state: dict[str, Any], endpoint: str) -> tuple[dict[str, Any], str]:
    path = endpoint.split("?", 1)[0].strip("/").split("/")
    if len(path) not in {6, 7} or path[:3] != ["repos", "example", "project"] or path[3] != "issues":
        fail("unsupported command")
    issue = state["issues"].get(path[4])
    if issue is None:
        fail("issue not found")
    return issue, "/".join(path[5:])


LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
with LOG_PATH.open("a", encoding="utf-8") as stream:
    stream.write(
        json.dumps(
            {
                "argv": ARGV,
                "stdin_length": len(STDIN.encode("utf-8")),
                "stdin_sha256": hashlib.sha256(STDIN.encode("utf-8")).hexdigest(),
            },
            separators=(",", ":"),
        )
        + "\n"
    )

state = load()
repository = state["repository"]

if ARGV[:2] == ["auth", "status"]:
    emit({"principal": state["principal"]})
    raise SystemExit(0)

if ARGV[:2] == ["repo", "view"]:
    requested = ARGV[2] if len(ARGV) > 2 else ""
    if requested != repository["nameWithOwner"]:
        fail("repository identity differs")
    emit(repository)
    raise SystemExit(0)

if ARGV[:1] == ["api"]:
    issue, collection = api_issue_and_collection(state, ARGV[1] if len(ARGV) > 1 else "")
    if "--paginate" not in ARGV or "--slurp" not in ARGV:
        fail("fixture requires --paginate --slurp")
    if collection == "sub_issues":
        refs = issue["subIssues"]
    elif collection == "dependencies/blocked_by":
        refs = issue["blockedBy"]
    elif collection == "dependencies/blocking":
        refs = issue["blocking"]
    else:
        fail("unsupported command")
    nodes = [state["issues"][str(ref["number"])] for ref in refs]
    if issue["number"] == 10 and len(nodes) == 2:
        emit([[nodes[0]], [nodes[1]]])
    else:
        emit([nodes])
    raise SystemExit(0)

if ARGV[:2] == ["issue", "view"]:
    requested_repo = flag("-R")
    if requested_repo != repository["nameWithOwner"]:
        fail("repository identity differs")
    key = issue_number(ARGV[2]) if len(ARGV) > 2 else ""
    if os.environ.get("MI_GITHUB_GRAPH_SCENARIO") == "unreadable-boundary" and key == "99":
        fail("required boundary is inaccessible")
    issue = state["issues"].get(key)
    if issue is None:
        fail("issue not found")
    emit(issue)
    raise SystemExit(0)

if ARGV[:2] in (["issue", "edit"], ["issue", "create"], ["issue", "close"], ["issue", "reopen"]):
    requested_repo = flag("-R")
    if requested_repo in state.get("shadow_repositories", []):
        fail("shadow repository is read-only")
    if requested_repo != repository["nameWithOwner"]:
        fail("repository identity differs")

if ARGV[:2] == ["issue", "edit"]:
    key = issue_number(ARGV[2]) if len(ARGV) > 2 else ""
    issue = state["issues"].get(key)
    if issue is None:
        fail("issue not found")
    if flag("--title") is not None:
        issue["title"] = flag("--title")
    if "--body-file" in ARGV:
        issue["body"] = body_from_stdin()
    if flag("--parent") is not None:
        parent = state["issues"].get(issue_number(flag("--parent", "")))
        if parent is None:
            fail("parent issue not found")
        if issue.get("parent") is not None:
            old_parent = state["issues"].get(str(issue["parent"]["number"]))
            if old_parent is not None:
                remove_ref(old_parent["subIssues"], issue)
        issue["parent"] = issue_ref(parent)
        add_unique_ref(parent["subIssues"], issue)
    if "--remove-parent" in ARGV and issue.get("parent") is not None:
        old_parent = state["issues"].get(str(issue["parent"]["number"]))
        if old_parent is not None:
            remove_ref(old_parent["subIssues"], issue)
        issue["parent"] = None
    for add_flag, source_key, target_key in (
        ("--add-blocking", "blocking", "blockedBy"),
        ("--add-blocked-by", "blockedBy", "blocking"),
    ):
        if flag(add_flag) is not None:
            related = state["issues"].get(issue_number(flag(add_flag, "")))
            if related is None:
                fail("related issue not found")
            add_unique_ref(issue[source_key], related)
            add_unique_ref(related[target_key], issue)
    for remove_flag, source_key, target_key in (
        ("--remove-blocking", "blocking", "blockedBy"),
        ("--remove-blocked-by", "blockedBy", "blocking"),
    ):
        if flag(remove_flag) is not None:
            related = state["issues"].get(issue_number(flag(remove_flag, "")))
            if related is None:
                fail("related issue not found")
            remove_ref(issue[source_key], related)
            remove_ref(related[target_key], issue)
    issue["updatedAt"] = "2026-08-12T00:00:01Z"
    save(state)
    print(issue["url"])
    raise SystemExit(0)

if ARGV[:2] == ["issue", "create"]:
    number = state["next_issue"]
    key = str(number)
    url = f'{repository["url"]}/issues/{number}'
    state["issues"][key] = {
        "id": f"I_{number}",
        "number": number,
        "title": flag("--title", ""),
        "body": body_from_stdin(),
        "state": "OPEN",
        "stateReason": None,
        "updatedAt": "2026-08-12T00:00:01Z",
        "url": url,
        "labels": [],
        "assignees": [],
        "issueType": None,
        "parent": None,
        "subIssues": [],
        "blockedBy": [],
        "blocking": [],
    }
    state["next_issue"] = number + 1
    save(state)
    if os.environ.get("MI_GITHUB_INDETERMINATE_CREATE") == "1":
        fail("create outcome is indeterminate")
    print(url)
    raise SystemExit(0)

if ARGV[:2] == ["issue", "close"]:
    key = issue_number(ARGV[2]) if len(ARGV) > 2 else ""
    issue = state["issues"].get(key)
    if issue is None:
        fail("issue not found")
    issue["state"] = "CLOSED"
    issue["stateReason"] = "NOT_PLANNED" if flag("--reason") == "not planned" else "COMPLETED"
    save(state)
    print(issue["url"])
    raise SystemExit(0)

if ARGV[:2] == ["issue", "reopen"]:
    key = issue_number(ARGV[2]) if len(ARGV) > 2 else ""
    issue = state["issues"].get(key)
    if issue is None:
        fail("issue not found")
    issue["state"] = "OPEN"
    issue["stateReason"] = None
    save(state)
    print(issue["url"])
    raise SystemExit(0)

fail("unsupported command")
