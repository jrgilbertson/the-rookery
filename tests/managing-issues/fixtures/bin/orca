#!/usr/bin/env python3
"""Small stateful orca linear fixture for managing-issues contract tests."""

from __future__ import annotations

import hashlib
import json
import os
import sys
from pathlib import Path
from typing import Any


ARGV = sys.argv[1:]
STATE_PATH = Path(os.environ["MI_LINEAR_STATE"])
LOG_PATH = Path(os.environ["MI_LINEAR_LOG"])
STDIN = sys.stdin.read() if "--body-file" in ARGV else ""


def emit(value: Any) -> None:
    print(json.dumps(value, separators=(",", ":"), sort_keys=True))


def fail(message: str) -> None:
    print(message, file=sys.stderr)
    raise SystemExit(1)


def flag(name: str, default: str | None = None) -> str | None:
    try:
        return ARGV[ARGV.index(name) + 1]
    except (ValueError, IndexError):
        return default


def load() -> dict[str, Any]:
    return json.loads(STATE_PATH.read_text(encoding="utf-8"))


def save(state: dict[str, Any]) -> None:
    temporary = STATE_PATH.with_name(f"{STATE_PATH.name}.tmp")
    temporary.write_text(json.dumps(state, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    temporary.replace(STATE_PATH)


def require_issue(state: dict[str, Any], identifier: str) -> dict[str, Any]:
    issue = state["issues"].get(identifier)
    if issue is None:
        fail("issue not found")
    return issue


def body_from_stdin() -> str:
    if flag("--body-file") != "-":
        fail("fixture requires --body-file -")
    return STDIN


def issue_ref(issue: dict[str, Any]) -> dict[str, Any]:
    return {"id": issue["id"], "identifier": issue["identifier"]}


def relation(issue: dict[str, Any], relation_type: str) -> dict[str, Any]:
    return {"type": relation_type, "issue": issue_ref(issue)}


def add_relation(issue: dict[str, Any], related: dict[str, Any], relation_type: str) -> None:
    if not any(edge["type"] == relation_type and edge["issue"]["id"] == related["id"] for edge in issue["relations"]):
        issue["relations"].append(relation(related, relation_type))


def remove_relation(issue: dict[str, Any], related: dict[str, Any], relation_type: str) -> None:
    issue["relations"] = [
        edge
        for edge in issue["relations"]
        if not (edge["type"] == relation_type and edge["issue"]["id"] == related["id"])
    ]


def add_child(parent: dict[str, Any], child: dict[str, Any]) -> None:
    if not any(candidate["id"] == child["id"] for candidate in parent["children"]):
        parent["children"].append(issue_ref(child))


def remove_child(parent: dict[str, Any], child: dict[str, Any]) -> None:
    parent["children"] = [candidate for candidate in parent["children"] if candidate["id"] != child["id"]]


LOG_PATH.parent.mkdir(parents=True, exist_ok=True)
with LOG_PATH.open("a", encoding="utf-8") as stream:
    stream.write(
        json.dumps(
            {
                "argv": ARGV,
                "stdin_length": len(STDIN.encode("utf-8")),
                "stdin_sha256": hashlib.sha256(STDIN.encode("utf-8")).hexdigest(),
            },
            separators=(",", ":"),
        )
        + "\n"
    )

state = load()

if ARGV[:3] == ["linear", "team", "list"]:
    emit({"principal": state["principal"], "workspace": state["workspace"], "teams": state["teams"]})
    raise SystemExit(0)

if ARGV[:3] == ["linear", "team", "states"]:
    emit({"states": state["states"]})
    raise SystemExit(0)

if ARGV[:3] == ["linear", "team", "labels"]:
    emit({"labels": state["labels"]})
    raise SystemExit(0)

if ARGV[:2] == ["linear", "list-issues"]:
    parent = flag("--parent-id")
    if parent is None:
        fail("missing --parent-id")
    cursor = flag("--cursor")
    scenario = os.environ.get("MI_LINEAR_GRAPH_SCENARIO", "complete")
    children = [
        issue
        for issue in state["issues"].values()
        if issue.get("parent") and issue["parent"]["identifier"] == parent
    ]
    children.sort(key=lambda item: item["identifier"])
    if scenario == "cap":
        page_number = {None: 1, "cap-2": 2, "cap-3": 3}.get(cursor)
        if page_number is None:
            fail("invalid cursor")
        count = 100 if page_number < 3 else 50
        start = (page_number - 1) * 100
        page = [
            {"id": f"cap-{number}", "identifier": f"CAP-{number}"}
            for number in range(start + 1, start + count + 1)
        ]
        emit(
            {
                "issues": page,
                "pageInfo": {
                    "hasNextPage": True,
                    "endCursor": f"cap-{page_number + 1}",
                },
            }
        )
        raise SystemExit(0)
    if cursor is None:
        emit(
            {
                "issues": children[:1],
                "pageInfo": {
                    "hasNextPage": len(children) > 1,
                    "endCursor": "repeat" if scenario == "repeated-cursor" else "page-2",
                },
            }
        )
        raise SystemExit(0)
    if scenario == "pagination-failure" and cursor == "page-2":
        fail("pagination failed")
    if scenario == "repeated-cursor" and cursor == "repeat":
        emit({"issues": children[1:2], "pageInfo": {"hasNextPage": True, "endCursor": "repeat"}})
        raise SystemExit(0)
    if cursor == "page-2":
        emit({"issues": children[1:], "pageInfo": {"hasNextPage": False, "endCursor": None}})
        raise SystemExit(0)
    fail("invalid cursor")

if ARGV[:2] == ["linear", "issue"]:
    identifier = ARGV[2] if len(ARGV) > 2 else ""
    emit({"issue": require_issue(state, identifier)})
    raise SystemExit(0)

if ARGV[:2] == ["linear", "save-issue"]:
    identifier = ARGV[2] if len(ARGV) > 2 else ""
    issue = require_issue(state, identifier)
    if flag("--title") is not None:
        issue["title"] = flag("--title")
    if "--body-file" in ARGV:
        issue["description"] = body_from_stdin()
    if flag("--parent-id") is not None:
        parent_value = flag("--parent-id")
        if issue.get("parent") is not None:
            old_parent = require_issue(state, issue["parent"]["identifier"])
            remove_child(old_parent, issue)
        if parent_value == "null":
            issue["parent"] = None
        else:
            parent = require_issue(state, parent_value or "")
            issue["parent"] = issue_ref(parent)
            add_child(parent, issue)
    save(state)
    emit({"issue": issue})
    raise SystemExit(0)

if ARGV[:2] == ["linear", "create"]:
    team_key = flag("--team")
    team = next((candidate for candidate in state["teams"] if candidate["key"] == team_key), None)
    if team is None:
        fail("team not found")
    number = state["next_issue"]
    identifier = f"{team_key}-{number}"
    issue = {
        "id": f"linear-{number}",
        "identifier": identifier,
        "team": {"id": team["id"], "key": team["key"]},
        "title": flag("--title", ""),
        "description": body_from_stdin(),
        "state": state["states"][0],
        "priority": "none",
        "estimate": None,
        "labels": [],
        "assignee": None,
        "parent": issue_ref(require_issue(state, flag("--parent", ""))) if flag("--parent") is not None else None,
        "children": [],
        "relations": [],
        "url": f"https://linear.app/fixture/issue/{identifier}",
    }
    state["issues"][identifier] = issue
    if issue["parent"] is not None:
        add_child(require_issue(state, issue["parent"]["identifier"]), issue)
    state["next_issue"] = number + 1
    save(state)
    if os.environ.get("MI_LINEAR_INDETERMINATE_CREATE") == "1":
        fail("linear_write_unconfirmed")
    emit({"issue": issue})
    raise SystemExit(0)

if len(ARGV) >= 4 and ARGV[:3] in (["linear", "relation", "add"], ["linear", "relation", "remove"]):
    operation = ARGV[2]
    issue = require_issue(state, ARGV[3])
    related = require_issue(state, flag("--related", "") or "")
    relation_type = flag("--type")
    inverse = {"blocks": "blocked-by", "blocked-by": "blocks"}
    if relation_type not in inverse:
        fail("unsupported relation type")
    if operation == "add":
        add_relation(issue, related, relation_type)
        add_relation(related, issue, inverse[relation_type])
    else:
        remove_relation(issue, related, relation_type)
        remove_relation(related, issue, inverse[relation_type])
    save(state)
    emit({"issue": issue})
    raise SystemExit(0)

if len(ARGV) >= 4 and ARGV[0] == "linear" and ARGV[2] == "set":
    operation = ARGV[1]
    identifier = ARGV[3]
    issue = require_issue(state, identifier)
    value = flag("--to-id") if operation == "assignee" else flag("--to")
    if value is None:
        fail("missing --to")
    if operation == "priority":
        issue["priority"] = value
    elif operation == "estimate":
        issue["estimate"] = int(value)
    elif operation == "assignee":
        issue["assignee"] = {"name": value}
    elif operation == "status":
        selected = next((candidate for candidate in state["states"] if candidate["name"] == value), None)
        if selected is None:
            fail("state not found")
        issue["state"] = selected
    else:
        fail("unsupported command")
    save(state)
    emit({"issue": issue})
    raise SystemExit(0)

if len(ARGV) >= 4 and ARGV[:2] == ["linear", "label"] and ARGV[2] in {"add", "remove"}:
    identifier = ARGV[3]
    issue = require_issue(state, identifier)
    label_name = flag("--label")
    selected = next((candidate for candidate in state["labels"] if candidate["name"] == label_name), None)
    if selected is None:
        fail("label not found")
    if ARGV[2] == "add" and selected not in issue["labels"]:
        issue["labels"].append(selected)
    if ARGV[2] == "remove":
        issue["labels"] = [label for label in issue["labels"] if label["id"] != selected["id"]]
    save(state)
    emit({"issue": issue})
    raise SystemExit(0)

fail("unsupported command")
