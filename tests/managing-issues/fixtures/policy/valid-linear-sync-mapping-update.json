{
  "version": 1,
  "provider": "linear",
  "target": "ENG",
  "synchronization": {
    "mapping_source": ".agents/linear-sync.json"
  },
  "mappings": {
    "work_type": {
      "bug": "label-bug-id",
      "feature": "label-feature-id",
      "maintenance": "label-maintenance-id"
    },
    "readiness": {
      "blocked": "state-blocked-id",
      "ready": "state-ready-id"
    },
    "priority": {
      "high": 2,
      "normal": 3,
      "urgent": 1
    },
    "leaf_estimate": {
      "large": 5,
      "medium": 3,
      "small": 1
    }
  }
}
