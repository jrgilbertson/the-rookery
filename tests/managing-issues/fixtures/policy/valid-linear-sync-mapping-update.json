{
  "version": 1,
  "provider": "linear",
  "target": {
    "workspace": "workspace-fixture",
    "team": "ENG"
  },
  "synchronization": {
    "mapping_source": ".agents/linear-sync.json"
  },
  "mappings": {
    "work_type": {
      "bug": "label-fix",
      "feature": "label-feature",
      "maintenance": "label-maintenance"
    },
    "readiness": {
      "blocked": "Blocked",
      "ready": "Ready"
    },
    "priority": {
      "high": "high",
      "normal": "medium",
      "urgent": "urgent"
    },
    "leaf_estimate": {
      "large": 5,
      "medium": 3,
      "small": 1
    }
  }
}
