#!/usr/bin/env bash
set -euo pipefail

die() {
  printf '%s\n' "$1" >&2
  exit "${2:-64}"
}

script_dir=$(cd "$(dirname "$0")" && pwd -P)
# shellcheck source=tests/personal-chief-of-staff/fixtures/lib/bootstrap.sh
source "$script_dir/../lib/bootstrap.sh"
fixture_bootstrap "$script_dir"

trace() {
  local operation=$1 token=$2 result=$3 completeness=$4
  printf '{"operation":"%s","target":"%s","result":"%s","completeness":"%s"}\n' \
    "$operation" "$token" "$result" "$completeness" >> "$trace_path"
}

reject() {
  local operation=$1 reason=$2 token=${3:-unrecognized}
  trace "$operation" "$token" rejected not_applicable
  die "$reason"
}

[[ $# -ge 2 ]] || reject rejected "expected operation and role" unrecognized
operation=$1
role_arg=$2
shift 2
case "$operation" in
  read|write|readback) ;;
  *) reject rejected "unsupported action fixture operation" unrecognized ;;
esac
[[ "$role_arg" == role=* ]] || reject "$operation" "role must be explicit"
role=${role_arg#role=}
[[ "$role" =~ ^[a-z][a-z0-9_]*$ ]] || reject "$operation" "unsafe role token"

content="__unset__"
for arg in "$@"; do
  case "$arg" in
    content=*) [[ "$content" == "__unset__" ]] || reject "$operation" "duplicate content" "$role"; content=${arg#content=} ;;
    *) reject "$operation" "unsupported action fixture parameter" "$role" ;;
  esac
done

action_dir="$fixture_dir/specimens/$PCOS_FIXTURE_SPECIMEN/actions/$role"
[[ -d "$action_dir" ]] || reject "$operation" "unknown action role" "$role"
[[ -f "$action_dir/before.txt" && -f "$action_dir/after.txt" && -f "$action_dir/write-token" ]] ||
  reject "$operation" "incomplete action fixture" "$role"
phase_metadata="$fixture_dir/specimens/$PCOS_FIXTURE_SPECIMEN/actions/source-discovery-after-readback"
phase_role=""
if [[ -f "$phase_metadata" ]]; then
  phase_role=$(<"$phase_metadata")
  [[ "$phase_role" =~ ^[a-z][a-z0-9_]*$ ]] ||
    reject "$operation" "unsafe source-discovery phase role" "$role"
fi

state_dir="$fixture_root/action-$role"
state_file="$state_dir/content"
written_file="$state_dir/written"
read_file="$state_dir/read"
write_claim_dir="$state_dir/write-claim"
readback_claim_dir="$state_dir/readback-claim"
operation_claim_dir="$state_dir/operation-claim"
phase_file="$state_dir/source-phase-complete"
operation_claim_held=0
fixture_prepare_state_dir \
  "$state_dir" "$state_file" "$written_file" "$read_file" "$phase_file"

release_operation_claim() {
  if [[ "$operation_claim_held" -eq 1 ]]; then
    rmdir "$operation_claim_dir" 2>/dev/null || true
  fi
}

acquire_operation_claim() {
  local attempts=0

  while ! mkdir "$operation_claim_dir" 2>/dev/null; do
    ((attempts += 1))
    [[ "$attempts" -lt 500 ]] || die "timed out waiting for action fixture operation" 75
    sleep 0.01
  done
  operation_claim_held=1
}

trap release_operation_claim EXIT
acquire_operation_claim
[[ -f "$state_file" ]] || cp "$action_dir/before.txt" "$state_file"
[[ -f "$written_file" ]] || printf '0\n' > "$written_file"
[[ -f "$read_file" ]] || printf '0\n' > "$read_file"

case "$operation" in
  read)
    [[ "$content" == "__unset__" ]] || reject read "read accepts no content" "$role"
    [[ "$(<"$written_file")" == 0 ]] || reject read "pre-write read is not permitted after a write" "$role"
    [[ "$(<"$read_file")" == 0 ]] || reject read "exactly one pre-write read is required" "$role"
    sed -n '1,$p' "$state_file"
    printf '1\n' > "$read_file"
    trace read "$role" success complete
    ;;
  write)
    [[ "$content" != "__unset__" ]] || reject write "write requires exact content token" "$role"
    [[ "$content" == "$(<"$action_dir/write-token")" ]] || reject write "unexpected action content" "$role"
    [[ "$(<"$read_file")" == 1 ]] || reject write "write requires a pre-write read" "$role"
    [[ "$(<"$written_file")" == 0 ]] || reject write "an extra write is not permitted" "$role"
    mkdir "$write_claim_dir" 2>/dev/null || reject write "an extra write is not permitted" "$role"
    cp "$action_dir/after.txt" "$state_file"
    printf '1\n' > "$written_file"
    if [[ -f "$action_dir/write.ambiguous" ]]; then
      trace write "$role" ambiguous not_applicable
      printf 'ambiguous\n'
    else
      trace write "$role" success not_applicable
      printf 'success\n'
    fi
    ;;
  readback)
    [[ "$content" == "__unset__" ]] || reject readback "readback accepts no content" "$role"
    [[ "$(<"$written_file")" == 1 ]] || reject readback "readback requires a prior write" "$role"
    mkdir "$readback_claim_dir" 2>/dev/null ||
      reject readback "an extra readback attempt is not permitted" "$role"
    if [[ -f "$action_dir/readback.failure" ]]; then
      trace readback "$role" failure unknown
      die "scripted authoritative readback failure" 69
    fi
    sed -n '1,$p' "$state_file"
    trace readback "$role" success complete
    if [[ -n "$phase_role" && "$role" == "$phase_role" ]]; then
      printf 'complete\n' > "$phase_file"
    fi
    ;;
esac
